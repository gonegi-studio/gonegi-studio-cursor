    },
    "repository_consistency_intelligence": {
      "type": "object"
    },
    "repository_incremental_index_model_intelligence": {
      "type": "object"
    },
    "repository_incremental_index_validation_intelligence": {
      "type": "object"
    },
    "repository_incremental_index_metrics": {
      "type": "object"
