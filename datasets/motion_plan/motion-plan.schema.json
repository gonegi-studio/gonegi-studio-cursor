{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/motion_plan/motion-plan.schema.json",
  "title": "MotionPlan",
  "description": "Deterministic motion plan between keyframes for PHASE-21 MOTION_PLAN_BUILDER_V1",
  "type": "object",
  "required": [
    "motion_plan_id",
    "phase",
    "source_keyframe_plan_id",
    "source_video_shot_state_id",
    "motion_segments"
  ],
  "additionalProperties": false,
  "properties": {
    "motion_plan_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "const": "PHASE-21-MOTION-PLAN-BUILDER-001" },
    "source_keyframe_plan_id": { "type": "string", "minLength": 1 },
    "source_video_shot_state_id": { "type": "string", "minLength": 1 },
    "motion_segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/motion_segment" }
    },
    "built_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "camera_motion_category": {
      "type": "string",
      "enum": ["static", "pan", "tilt", "push_in", "pull_out", "dolly", "orbit"]
    },
    "character_motion_category": {
      "type": "string",
      "enum": ["idle", "walk", "turn", "look", "gesture", "sit", "stand"]
    },
    "emotion_motion_category": {
      "type": "string",
      "enum": ["calm", "hope", "wonder", "reunion", "farewell"]
    },
    "environment_motion_category": {
      "type": "string",
      "enum": ["wind", "water", "cloud", "foliage", "ambient"]
    },
    "motion_segment": {
      "type": "object",
      "required": [
        "segment_id",
        "from_keyframe",
        "to_keyframe",
        "duration_seconds",
        "camera_motion",
        "character_motion",
        "emotion_motion",
        "environment_motion",
        "continuity_locks"
      ],
      "additionalProperties": false,
      "properties": {
        "segment_id": { "type": "string" },
        "from_keyframe": { "type": "integer", "minimum": 0 },
        "to_keyframe": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "camera_motion": { "$ref": "#/$defs/camera_motion" },
        "character_motion": {
          "type": "array",
          "items": { "$ref": "#/$defs/character_motion" },
          "minItems": 1
        },
        "emotion_motion": { "$ref": "#/$defs/emotion_motion" },
        "environment_motion": { "$ref": "#/$defs/environment_motion" },
        "continuity_locks": { "$ref": "#/$defs/continuity_locks" }
      }
    },
    "camera_motion": {
      "type": "object",
      "required": [
        "motion_category",
        "from_shot_type",
        "to_shot_type",
        "motion_progress_delta",
        "identity_safe"
      ],
      "properties": {
        "motion_category": { "$ref": "#/$defs/camera_motion_category" },
        "from_shot_type": { "type": "string" },
        "to_shot_type": { "type": "string" },
        "motion_progress_delta": { "type": "number", "minimum": 0, "maximum": 1 },
        "identity_safe": { "type": "boolean" },
        "speed": { "type": "string", "enum": ["static", "slow", "moderate"] }
      }
    },
    "character_motion": {
      "type": "object",
      "required": [
        "character_id",
        "motion_category",
        "from_position",
        "to_position",
        "identity_lock_preserved"
      ],
      "properties": {
        "character_id": { "type": "string" },
        "motion_category": { "$ref": "#/$defs/character_motion_category" },
        "from_position": { "type": "string" },
        "to_position": { "type": "string" },
        "identity_lock_preserved": { "type": "boolean" }
      }
    },
    "emotion_motion": {
      "type": "object",
      "required": [
        "motion_category",
        "emotion_id",
        "intensity_start",
        "intensity_end"
      ],
      "properties": {
        "motion_category": { "$ref": "#/$defs/emotion_motion_category" },
        "emotion_id": { "type": "string" },
        "intensity_start": { "type": "number", "minimum": 0, "maximum": 1 },
        "intensity_end": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "environment_motion": {
      "type": "object",
      "required": [
        "motion_category",
        "location_lock_preserved",
        "prop_lock_preserved"
      ],
      "properties": {
        "motion_category": { "$ref": "#/$defs/environment_motion_category" },
        "location_lock_preserved": { "type": "boolean" },
        "prop_lock_preserved": { "type": "boolean" },
        "elements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "continuity_locks": {
      "type": "object",
      "required": ["identity_locks", "location_locks", "composition_locks"],
      "properties": {
        "identity_locks": { "type": "array", "items": { "type": "string" } },
        "location_locks": { "type": "array", "items": { "type": "string" } },
        "composition_locks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
