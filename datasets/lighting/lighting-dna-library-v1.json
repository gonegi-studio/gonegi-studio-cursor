    "test_id": "RKB-002",
    "findings_addressed": {
      "lighting_drift": {
        "detected": true,
        "mitigation": "Reuse identical lighting_id color bundle (key, shadow, sky, ambient) for all shots in same time cluster."
      },
      "time_inconsistency": {
        "detected": true,
        "mitigation": "Lock time_period and sun_angle per sequence slot; do not advance without explicit narrative beat."
      },
      "scene_color_mutation": {
        "detected": true,
        "mitigation": "Apply contrast_profile and reflection_behavior consistently per lighting_id across same-place shots."
      },
      "same_time_multi_shot_requirement": {
        "required": true,
        "policy": "Consecutive shots sharing narrative time must use the same lighting_id and paired location default."
      }
    },
