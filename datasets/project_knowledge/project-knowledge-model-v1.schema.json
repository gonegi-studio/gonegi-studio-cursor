{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/project_knowledge/project-knowledge-model-v1.schema.json",
  "title": "ProjectKnowledgeModelV1Engine",
  "description": "Planning-only permanent Project Knowledge Model without repository scan or execution.",
