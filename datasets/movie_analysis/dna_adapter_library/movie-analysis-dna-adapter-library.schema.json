{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/dna_adapter_library/movie-analysis-dna-adapter-library.schema.json",
  "title": "MovieAnalysisDnaAdapterLibrary",
  "description": "Reusable DNA adapter library for PHASE-SOURCE-VIDEO-056",
  "type": "object",
  "required": [
    "adapter_library_id",
    "adapter_library_version",
    "phase",
    "assembled_at",
    "source_count",
    "cinematic_dna_set_id",
    "integration_set_id",
    "quality_gate_verdict",
    "entries",
    "safety_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "adapter_library_id": { "type": "string", "minLength": 1 },
    "adapter_library_version": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-056-MOVIE_ANALYSIS_DNA_ADAPTER_LIBRARY_V1"
    },
    "assembled_at": { "type": "string", "minLength": 1 },
    "source_count": { "type": "integer", "minimum": 1 },
    "cinematic_dna_set_id": { "type": "string", "minLength": 1 },
    "integration_set_id": { "type": "string", "minLength": 1 },
    "quality_gate_verdict": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DnaAdapterLibraryEntry" }
    },
    "safety_summary": { "$ref": "#/$defs/AdapterLibrarySafetySummary" }
  },
  "$defs": {
    "AdapterType": {
      "type": "string",
      "enum": [
        "scene_adapter",
        "camera_adapter",
        "emotion_adapter",
        "transition_adapter",
        "continuity_adapter",
        "storytelling_adapter"
      ]
    },
    "DnaAdapterDefinition": {
      "type": "object",
      "required": [
        "adapter_type",
        "adapter_id",
        "cinematic_dna_id",
        "pattern_ids",
        "pattern_signatures",
        "pattern_count",
        "adapter_ready",
        "library_only"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter_type": { "$ref": "#/$defs/AdapterType" },
        "adapter_id": { "type": "string", "minLength": 1 },
        "cinematic_dna_id": { "type": "string", "minLength": 1 },
        "pattern_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "pattern_signatures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "pattern_count": { "type": "integer", "minimum": 1 },
        "adapter_ready": { "type": "boolean", "const": true },
        "library_only": { "type": "boolean", "const": true }
      }
    },
    "AdapterLibrarySafety": {
      "type": "object",
      "required": [
        "planning_only",
        "runtime_execution",
        "video_generation",
        "image_generation",
        "gpu_execution",
        "external_call_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "runtime_execution": { "type": "boolean", "const": false },
        "video_generation": { "type": "boolean", "const": false },
        "image_generation": { "type": "boolean", "const": false },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false }
      }
    },
    "ImageAdapterMapping": {
      "type": "object",
      "required": [
        "consumer_target",
        "emotion_adapter",
        "character_pattern_refs",
        "adapter_ready"
      ],
      "additionalProperties": false,
      "properties": {
        "consumer_target": { "type": "string", "const": "image_app" },
        "emotion_adapter": { "type": "boolean" },
        "character_pattern_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adapter_ready": { "type": "boolean", "const": true }
      }
    },
    "VideoAdapterMapping": {
      "type": "object",
      "required": [
        "consumer_target",
        "scene_adapter",
        "camera_adapter",
        "transition_adapter",
        "continuity_adapter",
        "storytelling_adapter",
        "adapter_ready"
      ],
      "additionalProperties": false,
      "properties": {
        "consumer_target": { "type": "string", "const": "video_app" },
        "scene_adapter": { "type": "boolean" },
        "camera_adapter": { "type": "boolean" },
        "transition_adapter": { "type": "boolean" },
        "continuity_adapter": { "type": "boolean" },
        "storytelling_adapter": { "type": "boolean" },
        "adapter_ready": { "type": "boolean", "const": true }
      }
    },
    "DnaAdapterLibraryEntry": {
      "type": "object",
      "required": [
        "adapter_library_entry_id",
        "source_video_id",
        "cinematic_dna_id",
        "integration_id",
        "scene_adapter",
        "camera_adapter",
        "emotion_adapter",
        "transition_adapter",
        "continuity_adapter",
        "storytelling_adapter",
        "image_adapter_mapping",
        "video_adapter_mapping",
        "reusability_score",
        "library_readiness",
        "safety"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter_library_entry_id": { "type": "string", "minLength": 1 },
        "source_video_id": { "type": "string", "minLength": 1 },
        "cinematic_dna_id": { "type": "string", "minLength": 1 },
        "integration_id": { "type": "string", "minLength": 1 },
        "scene_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "camera_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "emotion_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "transition_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "continuity_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "storytelling_adapter": { "$ref": "#/$defs/DnaAdapterDefinition" },
        "image_adapter_mapping": { "$ref": "#/$defs/ImageAdapterMapping" },
        "video_adapter_mapping": { "$ref": "#/$defs/VideoAdapterMapping" },
        "reusability_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "library_readiness": { "type": "string", "enum": ["READY", "NOT_READY"] },
        "safety": { "$ref": "#/$defs/AdapterLibrarySafety" }
      }
    },
    "AdapterLibrarySafetySummary": {
      "type": "object",
      "required": [
        "planning_only",
        "runtime_execution",
        "video_generation",
        "image_generation",
        "gpu_execution",
        "external_call_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "runtime_execution": { "type": "boolean", "const": false },
        "video_generation": { "type": "boolean", "const": false },
        "image_generation": { "type": "boolean", "const": false },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false }
      }
    }
  }
}
