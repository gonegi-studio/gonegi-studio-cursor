        "description",
        "bundle_ref",
        "bundle_id",
        "bundle_version",
        "bundle_phase",
        "bundle_system_id",
        "bundle_evidence_ref",
        "bundle_verdict",
        "bundle_evidence_mode",
        "binding_mode",
        "role",
        "sealed_bundle_digest",
        "sealed_package_digest",
        "sealed_component_count",
        "packages_runtime_in_this_phase",
        "implements_bundle_in_this_phase"
      ],
      "properties": {
        "binding_id": { "const": "dsc-vendor-runtime-package-bundle-binding-v1" },
        "description": { "type": "string", "minLength": 1 },
