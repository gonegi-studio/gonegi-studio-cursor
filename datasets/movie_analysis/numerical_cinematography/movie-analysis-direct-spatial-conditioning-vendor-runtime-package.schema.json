    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_package_only",
        "read_only",
        "vendor_neutral",
        "reuses_certified_vendor_reference_bundle",
        "no_actual_implementation",
        "no_vendor_implementation",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "declares_runtime_execution",
        "packages_runtime_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "runtime_package_only": { "const": true },
        "read_only": { "const": true },
        "vendor_neutral": { "const": true },
        "reuses_certified_vendor_reference_bundle": { "const": true },
        "no_actual_implementation": { "const": true },
        "no_vendor_implementation": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "declares_runtime_execution": { "const": false },
        "packages_runtime_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
