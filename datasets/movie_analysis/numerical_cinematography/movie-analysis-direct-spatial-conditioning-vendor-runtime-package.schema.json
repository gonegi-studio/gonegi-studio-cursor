          "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-bundle-v1.json"
        },
        "bundle_id": { "const": "dsc-vendor-reference-bundle-v1" },
        "bundle_version": { "const": "1.0" },
        "bundle_phase": { "const": "PHASE-DSC-077" },
        "bundle_system_id": {
          "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_REFERENCE_BUNDLE_V1"
        },
        "bundle_evidence_ref": {
          "const": "reports/numerical_cinematography/DIRECT_SPATIAL_CONDITIONING_VENDOR_REFERENCE_BUNDLE_VALIDATION_REPORT.json"
        },
        "bundle_verdict": {
          "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_REFERENCE_BUNDLE_V1"
        },
        "bundle_evidence_mode": {
          "const": "phase_077_pass_verdict_gated_at_build_time"
        },
        "binding_mode": { "const": "exact_reuse" },
        "role": { "const": "runtime_root" },
        "sealed_bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sealed_package_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sealed_component_count": { "const": 42 },
        "packages_runtime_in_this_phase": { "const": false },
        "implements_bundle_in_this_phase": { "const": false }
      }
    },
    "runtime_package_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_id",
        "description",
        "root_section_id",
        "section_order",
        "closed_set",
        "sections",
        "transitive_seal",
        "vendor_specific_sections",
        "includes_implementations",
        "declares_runtime_execution"
      ],
      "properties": {
        "composition_id": { "const": "dsc-vendor-runtime-package-composition-v1" },
        "description": { "type": "string", "minLength": 1 },
        "root_section_id": { "const": "vendor_reference_bundle" },
        "section_order": { "const": "fixed_declared_order" },
        "closed_set": { "const": true },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "role", "kind", "artifact_ref", "order"],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "kind": {
                "enum": ["bundle_artifact", "bundle_schema", "bundle_registry"]
              },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          }
        },
        "transitive_seal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "sealed_via",
            "sealed_component_count",
            "re_lists_bundle_contents"
          ],
          "properties": {
            "policy": { "const": "bundle_contents_sealed_via_bundle_digest" },
            "sealed_via": { "const": "dsc-vendor-reference-bundle-v1" },
            "sealed_component_count": { "const": 42 },
            "re_lists_bundle_contents": { "const": false }
          }
        },
        "vendor_specific_sections": { "const": "forbidden" },
        "includes_implementations": { "const": false },
        "declares_runtime_execution": { "const": false }
      }
    },
    "runtime_package_manifest": {
      "type": "object",
      "additionalProperties": false,
