{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-runtime-package.schema.json",
  "title": "DirectSpatialConditioningVendorRuntimePackage",
  "description": "PHASE-DSC-079 design-only, read-only vendor runtime package. Defines runtime package schema, deterministic runtime package identity, Vendor Reference Bundle binding, runtime package composition, and content-addressed runtime package manifest over the passing PHASE-077 bundle. Seals the bundle, its shape contract, and its provenance registry directly, and seals the bundle contents transitively through the bundle digest. Packages no vendor runtime, declares no runtime execution, and binds to no vendor name, framework, or device.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_runtime_package_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "runtime_package_id",
    "runtime_package_version",
    "runtime_package_kind",
    "bundle_ref",
    "bundle_schema_ref",
    "bundle_registry_ref",
    "bundle_evidence_ref",
    "package_ref",
    "template_ref",
    "template_certification_ref",
    "numerical_runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "runtime_package_schema",
    "deterministic_runtime_package_identity",
    "vendor_reference_bundle_binding",
    "runtime_package_composition",
    "runtime_package_manifest",
    "runtime_vendors",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "vendor_runtime_package_id": {
      "const": "direct-spatial-conditioning-vendor-runtime-package-v1"
    },
    "phase": { "const": "PHASE-DSC-079" },
    "system_id": {
      "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_PACKAGE_V1"
    },
    "mode": { "const": "design_only_vendor_runtime_package" },
    "target": {
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_PACKAGE_V1"
    },
    "runtime_package_id": { "const": "dsc-vendor-runtime-package-v1" },
    "runtime_package_version": { "const": "1.0" },
    "runtime_package_kind": { "const": "vendor_runtime_package" },
    "bundle_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-bundle-v1.json"
    },
    "bundle_schema_ref": {
      "const": "datasets/movie_analysis/numerical_cinematography/movie-analysis-direct-spatial-conditioning-vendor-reference-bundle.schema.json"
    },
    "bundle_registry_ref": {
      "const": "datasets/movie_analysis/numerical_cinematography/movie-analysis-direct-spatial-conditioning-vendor-reference-bundle-registry-v1.json"
    },
