      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "description",
        "encoding",
        "runtime_package_id_policy",
        "bundle_ref",
        "required_fields",
        "optional_fields",
        "additional_fields"
      ],
      "properties": {
        "schema_id": { "const": "dsc-vendor-runtime-package-schema-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "runtime_package_id_policy": {
          "const": "opaque_runtime_package_id_no_vendor_binding"
        },
        "bundle_ref": { "const": "dsc-vendor-reference-bundle-v1" },
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optional_fields": { "type": "array", "maxItems": 0 },
        "additional_fields": { "const": false }
      }
    },
    "deterministic_runtime_package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "description",
        "runtime_package_id",
        "runtime_package_version",
        "identity_policy",
        "derivation",
        "purity",
        "seed_dependence",
        "time_dependence",
        "randomness",
        "vendor_binding",
        "framework_binding",
        "device_binding",
        "vendor_name",
        "capability_set_id",
        "capability_set_version",
        "spatial_frame_ref",
        "required_channels"
      ],
      "properties": {
        "identity_id": {
          "const": "dsc-vendor-runtime-package-deterministic-identity-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "runtime_package_id": { "const": "dsc-vendor-runtime-package-v1" },
        "runtime_package_version": { "const": "1.0" },
        "identity_policy": {
          "const": "opaque_runtime_package_id_no_vendor_binding"
        },
        "derivation": { "const": "literal_constant_declared_at_design_time" },
        "purity": { "const": "deterministic_pure_constant" },
        "seed_dependence": { "const": "none" },
        "time_dependence": { "const": "none" },
        "randomness": { "const": "none" },
        "vendor_binding": { "const": "none" },
        "framework_binding": { "const": "none" },
        "device_binding": { "const": "none" },
        "vendor_name": { "const": "none" },
        "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
        "capability_set_version": { "const": "1.0" },
        "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
        "required_channels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
