        "description": { "type": "string", "minLength": 1 },
        "integrity_method": { "const": "sha256_content_addressed_read_only" },
        "entry_count": { "const": 3 },
        "entries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "artifact_ref",
              "sha256",
              "bytes",
              "content_addressed"
            ],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "content_addressed": { "const": true }
            }
          }
        },
        "sealed_bundle_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sealed_package_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sealed_component_count": { "const": 42 },
        "runtime_package_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runtime_package_digest_method": {
          "const": "sha256_of_ordered_section_digests_and_sealed_bundle_digest"
        },
        "verifies_implementations_in_this_phase": { "const": false }
      }
    },
    "runtime_vendors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "runtime_policy",
        "packages_runtime_in_this_phase"
