{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-package.schema.json",
  "title": "DirectSpatialConditioningVendorReferencePackage",
  "description": "PHASE-DSC-075 design-only, read-only vendor reference package. Defines reference package schema, deterministic package identity, certified Vendor Implementation Template binding, package composition, and content-addressed package manifest over the certified PHASE-073 template and PHASE-074 certification. Composes references only; implements no vendor, binds to no vendor name, framework, or device, and modifies no member.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_reference_package_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "package_id",
    "package_version",
    "package_kind",
    "template_ref",
    "template_certification_ref",
    "implementation_profile_ref",
    "implementation_profile_certification_ref",
    "family_ref",
    "family_certification_ref",
    "reference_implementation_ref",
    "reference_implementation_certification_ref",
    "runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "reference_package_schema",
    "deterministic_package_identity",
    "vendor_implementation_template_binding",
    "package_composition",
    "package_manifest",
    "packaged_vendors",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "vendor_reference_package_id": {
      "const": "direct-spatial-conditioning-vendor-reference-package-v1"
    },
    "phase": { "const": "PHASE-DSC-075" },
    "system_id": {
      "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_REFERENCE_PACKAGE_V1"
    },
    "mode": { "const": "design_only_vendor_reference_package" },
    "target": {
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_REFERENCE_PACKAGE_V1"
    },
    "package_id": { "const": "dsc-vendor-reference-package-v1" },
    "package_version": { "const": "1.0" },
    "package_kind": { "const": "vendor_reference_package" },
    "template_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-template-v1.json"
    },
    "template_certification_ref": {
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-implementation-template-certification-v1.json"
    },
    "implementation_profile_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-profile-v1.json"
    },
    "implementation_profile_certification_ref": {
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-implementation-profile-certification-v1.json"
    },
    "family_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-family-v1.json"
    },
    "family_certification_ref": {
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-implementation-family-certification-v1.json"
    },
    "reference_implementation_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-implementation-v1.json"
    },
    "reference_implementation_certification_ref": {
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-reference-implementation-certification-v1.json"
    },
    "runtime_package_ref": {
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
    "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
    "capability_set_version": { "const": "1.0" },
    "reference_package_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "description",
        "encoding",
        "package_id_policy",
        "template_ref",
        "required_fields",
        "optional_fields",
        "additional_fields"
      ],
      "properties": {
        "schema_id": { "const": "dsc-vendor-reference-package-schema-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "package_id_policy": { "const": "opaque_package_id_no_vendor_binding" },
        "template_ref": { "const": "dsc-vendor-implementation-template-generic-v1" },
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optional_fields": { "type": "array", "maxItems": 0 },
        "additional_fields": { "const": false }
      }
    },
    "deterministic_package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "description",
        "package_id",
        "package_version",
        "identity_policy",
        "derivation",
        "purity",
        "seed_dependence",
        "time_dependence",
        "randomness",
        "vendor_binding",
        "framework_binding",
        "device_binding",
        "vendor_name",
        "capability_set_id",
        "capability_set_version",
        "spatial_frame_ref",
        "required_channels"
      ],
      "properties": {
        "identity_id": {
          "const": "dsc-vendor-reference-package-deterministic-identity-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "package_id": { "const": "dsc-vendor-reference-package-v1" },
        "package_version": { "const": "1.0" },
        "identity_policy": { "const": "opaque_package_id_no_vendor_binding" },
        "derivation": { "const": "literal_constant_declared_at_design_time" },
        "purity": { "const": "deterministic_pure_constant" },
        "seed_dependence": { "const": "none" },
        "time_dependence": { "const": "none" },
        "randomness": { "const": "none" },
        "vendor_binding": { "const": "none" },
        "framework_binding": { "const": "none" },
        "device_binding": { "const": "none" },
        "vendor_name": { "const": "none" },
        "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
        "capability_set_version": { "const": "1.0" },
        "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
        "required_channels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vendor_implementation_template_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "description",
        "template_ref",
        "template_id",
        "template_version",
        "template_phase",
        "template_system_id",
        "template_certification_ref",
        "binding_mode",
        "role",
        "packages_vendors_in_this_phase",
        "implements_template_in_this_phase"
      ],
      "properties": {
        "binding_id": {
          "const": "dsc-vendor-reference-package-template-binding-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "template_ref": {
          "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-template-v1.json"
        },
        "template_id": { "const": "dsc-vendor-implementation-template-generic-v1" },
        "template_version": { "const": "1.0" },
        "template_phase": { "const": "PHASE-DSC-073" },
        "template_system_id": {
          "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_IMPLEMENTATION_TEMPLATE_V1"
        },
        "template_certification_ref": {
          "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-implementation-template-certification-v1.json"
        },
        "binding_mode": { "const": "exact_reuse" },
        "role": { "const": "package_root" },
        "packages_vendors_in_this_phase": { "const": false },
        "implements_template_in_this_phase": { "const": false }
      }
    },
    "package_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_id",
        "description",
        "root_component_id",
        "component_order",
        "closed_set",
        "components",
        "vendor_specific_components",
        "includes_implementations"
      ],
      "properties": {
        "composition_id": {
          "const": "dsc-vendor-reference-package-composition-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "root_component_id": { "const": "vendor_implementation_template" },
        "component_order": { "const": "fixed_declared_order" },
        "closed_set": { "const": true },
        "components": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "role", "layer", "artifact_ref", "order"],
            "properties": {
              "component_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "layer": {
                "enum": [
                  "vendor_design",
                  "vendor_certification",
                  "backend_design",
                  "backend_certification",
                  "runtime"
                ]
              },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1, "maximum": 42 }
            }
          }
        },
        "vendor_specific_components": { "const": "forbidden" },
        "includes_implementations": { "const": false }
      }
    },
    "package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "description",
        "integrity_method",
        "entry_count",
        "entries",
        "package_digest",
        "package_digest_method",
        "verifies_implementations_in_this_phase"
      ],
      "properties": {
        "manifest_id": { "const": "dsc-vendor-reference-package-manifest-v1" },
        "description": { "type": "string", "minLength": 1 },
        "integrity_method": {
          "const": "sha256_content_addressed_read_only"
        },
        "entry_count": { "const": 42 },
        "entries": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "artifact_ref",
              "sha256",
              "bytes",
              "content_addressed"
            ],
            "properties": {
              "component_id": { "type": "string", "minLength": 1 },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "content_addressed": { "const": true }
            }
          }
        },
        "package_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "package_digest_method": {
          "const": "sha256_of_ordered_member_digests"
        },
        "verifies_implementations_in_this_phase": { "const": false }
      }
    },
    "packaged_vendors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "packaging_policy",
        "packages_vendors_in_this_phase"
      ],
      "properties": {
        "count": { "const": 0 },
        "entries": { "type": "array", "maxItems": 0 },
        "packaging_policy": { "type": "string", "minLength": 1 },
        "packages_vendors_in_this_phase": { "const": false }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_only",
        "read_only",
        "vendor_neutral",
        "reuses_certified_vendor_implementation_template",
        "no_actual_implementation",
        "no_vendor_implementation",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "packages_vendors_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "package_only": { "const": true },
        "read_only": { "const": true },
        "vendor_neutral": { "const": true },
        "reuses_certified_vendor_implementation_template": { "const": true },
        "no_actual_implementation": { "const": true },
        "no_vendor_implementation": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "packages_vendors_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
