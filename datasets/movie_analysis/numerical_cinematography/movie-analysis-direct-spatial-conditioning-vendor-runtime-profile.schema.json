              "const": "dsc-vendor-runtime-capability-profile-v1"
            },
            "description": { "type": "string", "minLength": 1 },
            "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
            "capability_set_version": { "const": "1.0" },
            "surface_order": { "const": "fixed_declared_order" },
            "closed_set": { "const": true },
            "surfaces": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surface_id",
                  "order",
                  "description",
                  "requires_gpu",
                  "performs_inference",
                  "vendor_binding",
                  "device_binding",
                  "selected_in_this_phase"
                ],
                "properties": {
                  "surface_id": {
                    "enum": [
                      "reference_cpu_surface",
                      "accelerated_surface",
                      "batch_surface"
                    ]
                  },
                  "order": { "type": "integer", "minimum": 1, "maximum": 3 },
                  "description": { "type": "string", "minLength": 1 },
                  "requires_gpu": { "const": false },
                  "performs_inference": { "const": false },
                  "vendor_binding": { "const": "none" },
                  "device_binding": { "const": "none" },
                  "selected_in_this_phase": { "const": false }
                }
              }
            },
            "required_channels": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "binds_concrete_surface_in_this_phase": { "const": false }
          }
        },
        "transitive_seal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "sealed_via",
            "sealed_component_count",
            "re_lists_runtime_bundle_contents"
          ],
          "properties": {
            "policy": {
              "const": "runtime_bundle_contents_sealed_via_runtime_bundle_digest"
            },
            "sealed_via": { "const": "dsc-vendor-runtime-bundle-v1" },
            "sealed_component_count": { "const": 42 },
            "re_lists_runtime_bundle_contents": { "const": false }
          }
        },
        "vendor_specific_sections": { "const": "forbidden" },
        "includes_implementations": { "const": false },
        "declares_runtime_execution": { "const": false }
      }
