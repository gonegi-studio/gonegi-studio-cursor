{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-runtime-profile.schema.json",
  "title": "DirectSpatialConditioningVendorRuntimeProfile",
  "description": "PHASE-DSC-083 design-only, read-only vendor runtime profile. Defines runtime profile schema, deterministic runtime profile identity, Vendor Runtime Bundle binding, runtime profile composition (with a vendor-neutral capability profile), and content-addressed runtime profile manifest over the passing PHASE-081 runtime bundle. Seals the runtime bundle, its shape contract, and its provenance registry directly, and seals the runtime bundle contents transitively through the runtime bundle digest. Profiles no vendor runtime, selects no concrete surface, declares no runtime execution, and binds to no vendor name, framework, or device.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_runtime_profile_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "runtime_profile_id",
    "runtime_profile_version",
    "runtime_profile_kind",
    "runtime_bundle_ref",
    "runtime_bundle_schema_ref",
    "runtime_bundle_registry_ref",
    "runtime_bundle_evidence_ref",
    "runtime_package_ref",
    "reference_bundle_ref",
    "package_ref",
    "template_ref",
    "template_certification_ref",
    "numerical_runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "runtime_profile_schema",
    "deterministic_runtime_profile_identity",
    "vendor_runtime_bundle_binding",
    "runtime_profile_composition",
    "runtime_profile_manifest",
    "profiled_runtime_vendors",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "vendor_runtime_profile_id": {
      "const": "direct-spatial-conditioning-vendor-runtime-profile-v1"
    },
    "phase": { "const": "PHASE-DSC-083" },
    "system_id": {
      "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_PROFILE_V1"
    },
    "mode": { "const": "design_only_vendor_runtime_profile" },
    "target": {
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_PROFILE_V1"
    },
    "runtime_profile_id": { "const": "dsc-vendor-runtime-profile-v1" },
    "runtime_profile_version": { "const": "1.0" },
    "runtime_profile_kind": { "const": "vendor_runtime_profile" },
    "runtime_bundle_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-runtime-bundle-v1.json"
    },
    "runtime_bundle_schema_ref": {
      "const": "datasets/movie_analysis/numerical_cinematography/movie-analysis-direct-spatial-conditioning-vendor-runtime-bundle.schema.json"
    },
    "runtime_bundle_registry_ref": {
      "const": "datasets/movie_analysis/numerical_cinematography/movie-analysis-direct-spatial-conditioning-vendor-runtime-bundle-registry-v1.json"
    },
    "runtime_bundle_evidence_ref": {
      "const": "reports/numerical_cinematography/DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_BUNDLE_VALIDATION_REPORT.json"
    },
    "runtime_package_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-runtime-package-v1.json"
    },
    "reference_bundle_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-bundle-v1.json"
    },
    "package_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-reference-package-v1.json"
    },
    "template_ref": {
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-template-v1.json"
    },
    "template_certification_ref": {
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-vendor-implementation-template-certification-v1.json"
    },
    "numerical_runtime_package_ref": {
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
    "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
    "capability_set_version": { "const": "1.0" },
    "runtime_profile_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "description",
        "encoding",
        "runtime_profile_id_policy",
        "runtime_bundle_ref",
        "required_fields",
        "optional_fields",
        "additional_fields"
      ],
      "properties": {
        "schema_id": { "const": "dsc-vendor-runtime-profile-schema-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "runtime_profile_id_policy": {
          "const": "opaque_runtime_profile_id_no_vendor_binding"
        },
        "runtime_bundle_ref": { "const": "dsc-vendor-runtime-bundle-v1" },
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optional_fields": { "type": "array", "maxItems": 0 },
        "additional_fields": { "const": false }
      }
    },
    "deterministic_runtime_profile_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "description",
        "runtime_profile_id",
        "runtime_profile_version",
        "identity_policy",
        "derivation",
        "purity",
        "seed_dependence",
        "time_dependence",
        "randomness",
        "vendor_binding",
        "framework_binding",
        "device_binding",
        "vendor_name",
        "capability_set_id",
        "capability_set_version",
        "spatial_frame_ref",
        "required_channels"
      ],
      "properties": {
        "identity_id": {
          "const": "dsc-vendor-runtime-profile-deterministic-identity-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "runtime_profile_id": { "const": "dsc-vendor-runtime-profile-v1" },
        "runtime_profile_version": { "const": "1.0" },
        "identity_policy": {
          "const": "opaque_runtime_profile_id_no_vendor_binding"
        },
        "derivation": { "const": "literal_constant_declared_at_design_time" },
        "purity": { "const": "deterministic_pure_constant" },
        "seed_dependence": { "const": "none" },
        "time_dependence": { "const": "none" },
        "randomness": { "const": "none" },
        "vendor_binding": { "const": "none" },
        "framework_binding": { "const": "none" },
        "device_binding": { "const": "none" },
        "vendor_name": { "const": "none" },
        "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
        "capability_set_version": { "const": "1.0" },
        "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
        "required_channels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vendor_runtime_bundle_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "description",
        "runtime_bundle_ref",
        "runtime_bundle_id",
        "runtime_bundle_version",
        "runtime_bundle_phase",
        "runtime_bundle_system_id",
        "runtime_bundle_evidence_ref",
        "runtime_bundle_verdict",
        "runtime_bundle_evidence_mode",
        "binding_mode",
        "role",
        "sealed_runtime_bundle_digest",
        "sealed_runtime_package_digest",
        "sealed_component_count",
        "profiles_runtime_in_this_phase",
        "implements_runtime_bundle_in_this_phase"
      ],
      "properties": {
        "binding_id": {
          "const": "dsc-vendor-runtime-profile-bundle-binding-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "runtime_bundle_ref": {
          "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-runtime-bundle-v1.json"
        },
        "runtime_bundle_id": { "const": "dsc-vendor-runtime-bundle-v1" },
        "runtime_bundle_version": { "const": "1.0" },
        "runtime_bundle_phase": { "const": "PHASE-DSC-081" },
        "runtime_bundle_system_id": {
          "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_BUNDLE_V1"
        },
        "runtime_bundle_evidence_ref": {
          "const": "reports/numerical_cinematography/DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_BUNDLE_VALIDATION_REPORT.json"
        },
        "runtime_bundle_verdict": {
          "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_RUNTIME_BUNDLE_V1"
        },
        "runtime_bundle_evidence_mode": {
          "const": "phase_081_pass_verdict_gated_at_build_time"
        },
        "binding_mode": { "const": "exact_reuse" },
        "role": { "const": "runtime_profile_root" },
        "sealed_runtime_bundle_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sealed_runtime_package_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sealed_component_count": { "const": 42 },
        "profiles_runtime_in_this_phase": { "const": false },
        "implements_runtime_bundle_in_this_phase": { "const": false }
      }
    },
    "runtime_profile_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_id",
        "description",
        "root_section_id",
        "section_order",
        "closed_set",
        "sections",
        "capability_profile",
        "transitive_seal",
        "vendor_specific_sections",
        "includes_implementations",
        "declares_runtime_execution"
      ],
      "properties": {
        "composition_id": {
          "const": "dsc-vendor-runtime-profile-composition-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "root_section_id": { "const": "vendor_runtime_bundle" },
        "section_order": { "const": "fixed_declared_order" },
        "closed_set": { "const": true },
        "sections": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "role", "kind", "artifact_ref", "order"],
            "properties": {
              "section_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "kind": {
                "enum": [
                  "runtime_bundle_artifact",
                  "runtime_bundle_schema",
                  "runtime_bundle_registry"
                ]
              },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          }
        },
        "capability_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_profile_id",
            "description",
            "capability_set_id",
            "capability_set_version",
            "surface_order",
            "closed_set",
            "surfaces",
            "required_channels",
            "binds_concrete_surface_in_this_phase"
