{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry.schema.json",
  "title": "DirectSpatialConditioningBackendCapabilityRegistry",
  "description": "PHASE-DSC-040 design-only, read-only, backend-agnostic capability registry. Defines the backend descriptor, the capability declaration schema, the compatibility matrix, and capability versioning over the frozen PHASE-039 capability contract. Registers and evaluates no backend and performs no GPU, inference, or dataset modification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_registry_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "adapter_foundation_ref",
    "adapter_foundation_phase",
    "adapter_foundation_system_id",
    "runtime_interface_ref",
    "runtime_package_ref",
    "sources_supported",
    "required_channels",
    "backend_descriptor",
    "capability_schema",
    "compatibility_matrix",
    "capability_versioning",
    "registered_backends",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "capability_registry_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-backend-capability-registry-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-040" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_CAPABILITY_REGISTRY_V1"
    },
    "mode": { "type": "string", "const": "design_only_registry" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_BACKEND_CAPABILITY_REGISTRY_V1"
    },
    "adapter_foundation_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-foundation-v1.json"
    },
    "adapter_foundation_phase": { "type": "string", "const": "PHASE-DSC-039" },
    "adapter_foundation_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_FOUNDATION_V1"
    },
    "runtime_interface_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json"
    },
    "runtime_package_ref": {
      "type": "string",
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "backend_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_id",
        "description",
        "produced_by_method",
        "adapter_interface_ref",
        "required_fields",
        "optional_fields",
        "identity_policy",
        "additional_fields"
      ],
      "properties": {
        "descriptor_id": { "const": "dsc-backend-descriptor-v1" },
        "description": { "type": "string", "minLength": 1 },
        "produced_by_method": { "const": "describe_capabilities" },
        "adapter_interface_ref": { "const": "dsc-backend-adapter-interface-v1" },
        "required_fields": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optional_fields": { "type": "array", "maxItems": 0 },
        "identity_policy": { "const": "opaque_backend_id_no_vendor_binding" },
        "additional_fields": { "const": false }
      }
    },
    "capability_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "description",
        "capability_contract_ref",
        "fields",
        "registered_capability_ids",
        "declaration_values",
        "unknown_capability_policy",
        "duplicate_capability_policy",
        "missing_capability_policy",
        "additional_fields"
      ],
      "properties": {
        "schema_id": { "const": "dsc-backend-capability-declaration-v1" },
        "description": { "type": "string", "minLength": 1 },
        "capability_contract_ref": {
          "const": "dsc-backend-capability-contract-v1"
        },
        "fields": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "registered_capability_ids": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "declaration_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "supported" }, { "const": "unsupported" }]
        },
        "unknown_capability_policy": {
          "const": "reject_unregistered_capability_id"
        },
        "duplicate_capability_policy": {
          "const": "reject_duplicate_capability_id"
        },
        "missing_capability_policy": { "const": "treated_as_undeclared" },
        "additional_fields": { "const": false }
      }
    },
    "compatibility_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_id",
        "description",
        "evaluated_by_method",
        "declaration_states",
        "state_semantics",
        "outcome_values",
        "rows",
        "aggregation_rule",
        "evaluation",
        "report_shape",
        "evaluates_backends_in_this_phase"
      ],
      "properties": {
        "matrix_id": { "const": "dsc-backend-compatibility-matrix-v1" },
        "description": { "type": "string", "minLength": 1 },
        "evaluated_by_method": { "const": "check_compatibility" },
        "declaration_states": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "supported" },
            { "const": "unsupported" },
            { "const": "undeclared" }
          ]
        },
        "state_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "unsupported", "undeclared"],
          "properties": {
            "supported": { "type": "string", "minLength": 1 },
            "unsupported": { "type": "string", "minLength": 1 },
            "undeclared": { "type": "string", "minLength": 1 }
          }
        },
        "outcome_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "compatible" }, { "const": "incompatible" }]
        },
        "rows": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row_id",
              "row_kind",
              "requirement",
              "required_value",
              "source_ref",
              "outcome_by_state",
              "incompatibility_code"
            ],
            "properties": {
              "row_id": { "type": "string", "minLength": 1 },
              "row_kind": { "enum": ["capability", "structural"] },
              "requirement": { "const": "mandatory" },
              "required_value": { "type": "string", "minLength": 1 },
              "source_ref": { "type": "string", "minLength": 1 },
              "outcome_by_state": {
                "type": "object",
                "additionalProperties": false,
                "required": ["supported", "unsupported", "undeclared"],
                "properties": {
                  "supported": { "const": "compatible" },
                  "unsupported": { "const": "incompatible" },
                  "undeclared": { "const": "incompatible" }
                }
              },
              "incompatibility_code": {
                "type": "string",
                "pattern": "^DSC_BACKEND_INCOMPATIBLE_[A-Z0-9_]+$"
              }
            }
          }
        },
        "aggregation_rule": { "const": "all_rows_must_resolve_compatible" },
        "evaluation": { "const": "collect_all_incompatibility_codes" },
        "report_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report_id", "required_fields", "outcome_values"],
          "properties": {
            "report_id": { "const": "dsc-backend-compatibility-report-v1" },
            "required_fields": {
              "type": "array",
              "minItems": 6,
              "items": { "type": "string", "minLength": 1 }
            },
            "outcome_values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "const": "compatible" },
                { "const": "incompatible" }
              ]
            }
          }
        },
        "evaluates_backends_in_this_phase": { "const": false }
      }
    },
    "capability_versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versioning_id",
        "description",
        "scheme",
        "capability_set_id",
        "current_capability_set_version",
        "supported_capability_set_versions",
        "capability_versions",
        "compatibility_policy",
        "rules",
        "deprecation_policy"
      ],
      "properties": {
        "versioning_id": { "const": "dsc-backend-capability-versioning-v1" },
        "description": { "type": "string", "minLength": 1 },
        "scheme": { "const": "major_minor" },
        "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
        "current_capability_set_version": { "const": "1.0" },
        "supported_capability_set_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capability_versions": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "introduced_in_capability_set_version",
              "current_version",
              "status"
            ],
            "properties": {
              "capability_id": { "type": "string", "minLength": 1 },
              "introduced_in_capability_set_version": {
                "type": "string",
                "minLength": 1
              },
              "current_version": { "type": "string", "minLength": 1 },
              "status": { "const": "active" }
            }
          }
        },
        "compatibility_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major_change",
            "minor_change",
            "major_mismatch",
            "minor_mismatch"
          ],
          "properties": {
            "major_change": { "type": "string", "minLength": 1 },
            "minor_change": { "type": "string", "minLength": 1 },
            "major_mismatch": { "const": "incompatible" },
            "minor_mismatch": {
              "const": "compatible_if_major_matches_and_all_mandatory_rows_supported"
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "deprecation_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deprecated_capabilities",
            "removal_requires",
            "notice_window"
          ],
          "properties": {
            "deprecated_capabilities": { "type": "array", "maxItems": 0 },
            "removal_requires": {
              "const": "major_capability_set_version_increment"
            },
            "notice_window": { "const": "one_minor_version" }
          }
        }
      }
    },
    "registered_backends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "registration_policy",
        "registers_backends_in_this_phase"
      ],
      "properties": {
        "count": { "const": 0 },
        "entries": { "type": "array", "maxItems": 0 },
        "registration_policy": { "type": "string", "minLength": 1 },
        "registers_backends_in_this_phase": { "const": false }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_only",
        "read_only",
        "backend_agnostic",
        "reuses_adapter_foundation",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "evaluates_backends_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "registry_only": { "const": true },
        "read_only": { "const": true },
        "backend_agnostic": { "const": true },
        "reuses_adapter_foundation": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "evaluates_backends_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
