{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-packet-assembly.schema.json",
  "title": "DirectSpatialConditioningPacketAssemblySpecification",
  "description": "PHASE-DSC-034 design-only packet assembly specification. Maps the certified Movie Reconstruction runtime package (PHASE-027) consumption layer into a PHASE-032 conditioning packet via required inputs, ordered steps, and field-level source mappings. Assembles no packet instance and performs no backend, GPU, inference, or dataset modification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assembly_specification_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "packet_ref",
    "validation_ref",
    "runtime_package_ref",
    "runtime_package_phase",
    "runtime_consumption_layer",
    "sources_supported",
    "required_inputs",
    "assembly_order",
    "metadata_assembly",
    "channel_assemblies",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "assembly_specification_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-packet-assembly-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-034" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_PACKET_ASSEMBLY_V1"
    },
    "mode": { "type": "string", "const": "design_only_assembly" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_PACKET_ASSEMBLY_V1"
    },
    "packet_ref": { "type": "string", "minLength": 1 },
    "validation_ref": { "type": "string", "minLength": 1 },
    "runtime_package_ref": {
      "type": "string",
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "runtime_package_phase": { "type": "string", "const": "PHASE-MOVIE-RECONSTRUCTION-027" },
    "runtime_consumption_layer": { "type": "string", "const": "consumption" },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_inputs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "kind", "ref", "description", "read_only"],
        "properties": {
          "input_id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["certified_artifact", "runtime_selector", "caller_value", "design_artifact"]
          },
          "ref": { "type": ["string", "null"] },
          "description": { "type": "string", "minLength": 1 },
          "read_only": { "const": true }
        }
      }
    },
    "assembly_order": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_index", "step_id", "description", "reads", "produces"],
        "properties": {
          "step_index": { "type": "integer", "minimum": 0 },
          "step_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "reads": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "produces": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata_assembly": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/envelopeFieldMapping" }
    },
    "channel_assemblies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "order_index",
          "foundation_consumption_slot",
          "runtime_layer",
          "envelope_field_mappings",
          "component_source_mappings"
        ],
        "properties": {
          "channel_id": {
            "enum": [
              "camera_pose_field",
              "camera_temporal_track",
              "subject_position_field",
              "framing_composition_map",
              "edit_rhythm_boundaries",
              "scene_energy_field"
            ]
          },
          "order_index": { "type": "integer", "minimum": 0, "maximum": 5 },
          "foundation_consumption_slot": { "type": "string", "minLength": 1 },
          "runtime_layer": { "const": "consumption" },
          "envelope_field_mappings": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": { "$ref": "#/$defs/envelopeFieldMapping" }
          },
          "component_source_mappings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packet_component",
                "value_kind",
                "source_consumption_slot",
                "payload_path",
                "additional_source_paths",
                "extraction",
                "label_rule",
                "note"
              ],
              "properties": {
                "packet_component": { "type": "string", "minLength": 1 },
                "value_kind": {
                  "enum": ["number", "string", "boolean", "number_array", "string_array"]
                },
                "source_consumption_slot": {
                  "enum": [
                    "edit_rhythm",
                    "framing",
                    "camera_pose",
                    "camera_temporal",
                    "subject_temporal",
                    "scene_energy"
                  ]
                },
                "payload_path": { "type": "string", "minLength": 1 },
                "additional_source_paths": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "extraction": {
                  "enum": [
                    "direct_copy",
                    "rename_copy",
                    "unit_normalize_degrees_to_radians",
                    "deterministic_label"
                  ]
                },
                "label_rule": {
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "required": ["from_fields", "bands"],
                  "properties": {
                    "from_fields": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "bands": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly_only",
        "reuses_certified_runtime_package",
        "backend",
        "gpu",
        "inference",
        "assembles_packet_instances_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "assembly_only": { "const": true },
        "reuses_certified_runtime_package": { "const": true },
        "backend": { "const": "none" },
        "gpu": { "const": false },
        "inference": { "const": false },
        "assembles_packet_instances_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "envelopeFieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "source_kind", "value", "runtime_record_path", "note"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "source_kind": {
          "enum": ["constant", "runtime_record_field", "caller_provided"]
        },
        "value": { "type": ["string", "number", "null"] },
        "runtime_record_path": { "type": ["string", "null"] },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
