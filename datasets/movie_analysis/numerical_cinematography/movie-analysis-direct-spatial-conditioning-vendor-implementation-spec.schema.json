{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-implementation-spec.schema.json",
  "title": "DirectSpatialConditioningVendorImplementationSpec",
  "description": "PHASE-DSC-061 design-only, read-only, vendor-neutral vendor implementation specification. Defines vendor implementation requirements, required interfaces, deterministic compliance checklist, and implementation report over the certified PHASE-060 vendor execution contract. Implements no vendor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vendor_implementation_spec_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "vendor_execution_contract_ref",
    "vendor_execution_contract_phase",
    "vendor_execution_contract_system_id",
    "vendor_router_ref",
    "vendor_compatibility_ref",
    "vendor_registry_ref",
    "vendor_profile_ref",
    "family_ref",
    "family_certification_ref",
    "reference_backend_ref",
    "reference_backend_certification_ref",
    "template_ref",
    "template_certification_ref",
    "profile_ref",
    "profile_certification_ref",
    "backend_design_certification_ref",
    "implementation_spec_ref",
    "execution_contract_ref",
    "runtime_router_ref",
    "adapter_registration_ref",
    "compatibility_engine_ref",
    "capability_registry_ref",
    "adapter_foundation_ref",
    "runtime_interface_ref",
    "runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "vendor_implementation_requirements",
    "required_interfaces",
    "deterministic_compliance_checklist",
    "implementation_report",
    "implemented_vendors",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "vendor_implementation_spec_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-vendor-implementation-spec-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-061" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_IMPLEMENTATION_SPEC_V1"
    },
    "mode": {
      "type": "string",
      "const": "design_only_vendor_implementation_spec"
    },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_VENDOR_IMPLEMENTATION_SPEC_V1"
    },
    "vendor_execution_contract_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-execution-contract-v1.json"
    },
    "vendor_execution_contract_phase": {
      "type": "string",
      "const": "PHASE-DSC-060"
    },
    "vendor_execution_contract_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_VENDOR_EXECUTION_CONTRACT_V1"
    },
    "vendor_router_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-router-v1.json"
    },
    "vendor_compatibility_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-compatibility-v1.json"
    },
    "vendor_registry_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-registry-v1.json"
    },
    "vendor_profile_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-profile-v1.json"
    },
    "family_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-family-v1.json"
    },
    "family_certification_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-backend-family-certification-v1.json"
    },
    "reference_backend_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-reference-backend-v1.json"
    },
    "reference_backend_certification_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-reference-backend-certification-v1.json"
    },
    "template_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-template-v1.json"
    },
    "template_certification_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-backend-template-certification-v1.json"
    },
    "profile_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-profile-v1.json"
    },
    "profile_certification_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-backend-profile-certification-v1.json"
    },
    "backend_design_certification_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-backend-design-certification-v1.json"
    },
    "implementation_spec_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-implementation-spec-v1.json"
    },
    "execution_contract_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-execution-contract-v1.json"
    },
    "runtime_router_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-runtime-router-v1.json"
    },
    "adapter_registration_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-registration-v1.json"
    },
    "compatibility_engine_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-compatibility-engine-v1.json"
    },
    "capability_registry_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry-v1.json"
    },
    "adapter_foundation_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-foundation-v1.json"
    },
    "runtime_interface_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json"
    },
    "runtime_package_ref": {
      "type": "string",
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
    "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
    "capability_set_version": { "const": "1.0" },
    "vendor_implementation_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_id", "description", "requirements"],
      "properties": {
        "requirements_id": {
          "const": "dsc-vendor-implementation-requirements-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_id",
              "category",
              "description",
              "mandatory",
              "evidence_ref",
              "implemented_in_this_phase"
            ],
            "properties": {
              "requirement_id": { "type": "string", "minLength": 1 },
              "category": {
                "enum": [
                  "identity",
                  "interface",
                  "compatibility",
                  "registry",
                  "routing",
                  "execution",
                  "determinism",
                  "constraints"
                ]
              },
              "description": { "type": "string", "minLength": 1 },
              "mandatory": { "const": true },
              "evidence_ref": { "type": "string", "minLength": 1 },
              "implemented_in_this_phase": { "const": false }
            }
          }
        }
      }
    },
    "required_interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interfaces_id",
        "description",
        "vendor_capability_interface_ref",
        "vendor_profile_ref",
        "methods",
        "surfaces",
        "implements_interfaces_in_this_phase"
      ],
      "properties": {
        "interfaces_id": { "const": "dsc-vendor-required-interfaces-v1" },
        "description": { "type": "string", "minLength": 1 },
        "vendor_capability_interface_ref": {
          "const": "dsc-vendor-capability-interface-v1"
        },
        "vendor_profile_ref": {
          "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-vendor-profile-v1.json"
        },
        "methods": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method_id",
              "signature",
              "source_interface",
              "abstract",
              "must_be_implemented_by_vendor",
              "requires_gpu",
              "performs_inference",
              "implemented_in_this_phase"
            ],
            "properties": {
              "method_id": { "type": "string", "minLength": 1 },
              "signature": { "type": "string", "minLength": 1 },
              "source_interface": {
                "const": "dsc-vendor-capability-interface-v1"
              },
              "abstract": { "const": true },
              "must_be_implemented_by_vendor": { "const": true },
              "requires_gpu": { "const": false },
              "performs_inference": { "const": false },
              "implemented_in_this_phase": { "const": false }
            }
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface_id",
              "artifact_ref",
              "purpose",
              "mandatory"
            ],
            "properties": {
              "surface_id": { "type": "string", "minLength": 1 },
              "artifact_ref": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "mandatory": { "const": true }
            }
          }
        },
        "implements_interfaces_in_this_phase": { "const": false }
      }
    },
    "deterministic_compliance_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checklist_id",
        "description",
        "evaluation",
        "accept_condition",
        "outcome_values",
        "items",
        "evaluates_implementations_in_this_phase"
      ],
      "properties": {
        "checklist_id": {
          "const": "dsc-vendor-deterministic-compliance-checklist-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "evaluation": { "const": "collect_all_failures" },
        "accept_condition": { "const": "zero failed checks" },
        "outcome_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "compliant" },
            { "const": "non_compliant" }
          ]
        },
        "items": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "requirement_id",
              "description",
              "evaluation",
              "pass_condition",
              "fail_code",
              "status_in_this_phase",
              "mandatory"
            ],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "requirement_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "evaluation": { "const": "design_time_declaration_only" },
              "pass_condition": { "type": "string", "minLength": 1 },
              "fail_code": {
                "type": "string",
                "pattern": "^DSC_VENDOR_IMPL_FAIL_[A-Z0-9_]+$"
              },
              "status_in_this_phase": { "const": "not_evaluated" },
              "mandatory": { "const": true }
            }
          }
        },
        "evaluates_implementations_in_this_phase": { "const": false }
      }
    },
    "implementation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema_id",
        "report_id",
        "description",
        "encoding",
        "required_fields",
        "outcome_values",
        "checklist_entry_shape",
        "ordering",
        "additional_fields",
        "materializes_tensors",
        "materializes_frames",
        "evaluates_implementations_in_this_phase"
      ],
      "properties": {
        "report_schema_id": {
          "const": "dsc-vendor-implementation-report-schema-v1"
        },
        "report_id": { "const": "dsc-vendor-implementation-report-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outcome_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "compliant" },
            { "const": "non_compliant" }
          ]
        },
        "checklist_entry_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields", "status_values"],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                { "const": "check_id" },
                { "const": "requirement_id" },
                { "const": "status" },
                { "const": "fail_code_or_null" },
                { "const": "evidence_note" }
              ]
            },
            "status_values": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "const": "pass" },
                { "const": "fail" },
                { "const": "not_evaluated" }
              ]
            }
          }
        },
        "ordering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checklist_results", "failed_checks"],
          "properties": {
            "checklist_results": { "const": "checklist_item_order" },
            "failed_checks": { "const": "checklist_item_order" }
          }
        },
        "additional_fields": { "const": false },
        "materializes_tensors": { "const": false },
        "materializes_frames": { "const": false },
        "evaluates_implementations_in_this_phase": { "const": false }
      }
    },
    "implemented_vendors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "implementation_policy",
        "implements_vendors_in_this_phase"
      ],
      "properties": {
        "count": { "const": 0 },
        "entries": { "type": "array", "maxItems": 0 },
        "implementation_policy": { "type": "string", "minLength": 1 },
        "implements_vendors_in_this_phase": { "const": false }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification_only",
        "read_only",
        "vendor_neutral",
        "reuses_vendor_execution_contract",
        "no_vendor_implementation",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "implements_vendors_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "specification_only": { "const": true },
        "read_only": { "const": true },
        "vendor_neutral": { "const": true },
        "reuses_vendor_execution_contract": { "const": true },
        "no_vendor_implementation": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "implements_vendors_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
