{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-validation.schema.json",
  "title": "DirectSpatialConditioningRuntimeValidationSpecification",
  "description": "PHASE-DSC-037 design-only runtime interface validation. Verifies runtime API, packet flow, interface contract, and generation reuse against the PHASE-036 runtime interface and PHASE-035 packet generation. Executes no runtime methods and performs no backend, GPU, inference, or dataset modification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_specification_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "runtime_interface_ref",
    "runtime_interface_phase",
    "runtime_interface_system_id",
    "generation_ref",
    "generation_phase",
    "generation_system_id",
    "validation_procedure",
    "runtime_api_checks",
    "packet_flow_checks",
    "interface_contract_checks",
    "generation_reuse_checks",
    "expected_api_methods",
    "expected_packet_flow",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "validation_specification_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-runtime-validation-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-037" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_RUNTIME_VALIDATION_V1"
    },
    "mode": { "type": "string", "const": "design_only_validation" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_RUNTIME_VALIDATION_V1"
    },
    "runtime_interface_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json"
    },
    "runtime_interface_phase": { "type": "string", "const": "PHASE-DSC-036" },
    "runtime_interface_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_RUNTIME_INTERFACE_V1"
    },
    "generation_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-packet-generation-v1.json"
    },
    "generation_phase": { "type": "string", "const": "PHASE-DSC-035" },
    "generation_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_PACKET_GENERATION_V1"
    },
    "validation_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_stages", "evaluation", "accept_condition", "outcome_values"],
      "properties": {
        "ordered_stages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "runtime_api" },
            { "const": "packet_flow" },
            { "const": "interface_contract" },
            { "const": "generation_reuse" }
          ]
        },
        "evaluation": { "const": "collect_all_failures" },
        "accept_condition": { "type": "string", "minLength": 1 },
        "outcome_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "accepted" }, { "const": "rejected" }]
        }
      }
    },
    "runtime_api_checks": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/validationCheck" }
    },
    "packet_flow_checks": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/validationCheck" }
    },
    "interface_contract_checks": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/validationCheck" }
    },
    "generation_reuse_checks": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/validationCheck" }
    },
    "expected_api_methods": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "list_sources",
          "generate_packet",
          "validate_packet",
          "produce_validated_packet"
        ]
      }
    },
    "expected_packet_flow": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_only",
        "reuses_runtime_interface",
        "reuses_packet_generation",
        "backend",
        "gpu",
        "inference",
        "executes_runtime_methods_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "validation_only": { "const": true },
        "reuses_runtime_interface": { "const": true },
        "reuses_packet_generation": { "const": true },
        "backend": { "const": "none" },
        "gpu": { "const": false },
        "inference": { "const": false },
        "executes_runtime_methods_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "stage", "applies_to", "description", "predicate", "severity"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "stage": {
          "enum": ["runtime_api", "packet_flow", "interface_contract", "generation_reuse"]
        },
        "applies_to": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "severity": { "const": "error" }
      }
    }
  }
}
