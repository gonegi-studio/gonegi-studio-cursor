{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-registration.schema.json",
  "title": "DirectSpatialConditioningBackendAdapterRegistration",
  "description": "PHASE-DSC-042 design-only, read-only, backend-agnostic adapter registration surface. Defines the registration flow, registration record schema, lifecycle, deregistration policy, and registration validation over the frozen PHASE-041 compatibility engine. Registers no adapter and performs no GPU, inference, or dataset modification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_registration_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "compatibility_engine_ref",
    "compatibility_engine_phase",
    "compatibility_engine_system_id",
    "capability_registry_ref",
    "adapter_foundation_ref",
    "runtime_interface_ref",
    "runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "registration_flow",
    "registration_schema",
    "lifecycle",
    "deregistration_policy",
    "registration_validation",
    "registered_adapters",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "adapter_registration_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-backend-adapter-registration-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-042" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_REGISTRATION_V1"
    },
    "mode": { "type": "string", "const": "design_only_registration" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_REGISTRATION_V1"
    },
    "compatibility_engine_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-compatibility-engine-v1.json"
    },
    "compatibility_engine_phase": { "type": "string", "const": "PHASE-DSC-041" },
    "compatibility_engine_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_COMPATIBILITY_ENGINE_V1"
    },
    "capability_registry_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry-v1.json"
    },
    "adapter_foundation_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-foundation-v1.json"
    },
    "runtime_interface_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json"
    },
    "runtime_package_ref": {
      "type": "string",
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
    "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
    "capability_set_version": { "const": "1.0" },
    "registration_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "description",
        "ordered_stages",
        "reuse_policy",
        "accept_condition",
        "reject_condition"
      ],
      "properties": {
        "flow_id": { "const": "dsc-backend-adapter-registration-flow-v1" },
        "description": { "type": "string", "minLength": 1 },
        "ordered_stages": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "order",
              "description",
              "inputs",
              "outputs",
              "side_effects",
              "executed_in_this_phase"
            ],
            "properties": {
              "stage_id": {
                "enum": [
                  "bind_registration_request",
                  "run_compatibility_engine",
                  "validate_registration_payload",
                  "allocate_registration_identity",
                  "write_registration_record",
                  "emit_registration_receipt"
                ]
              },
              "order": { "type": "integer", "minimum": 1, "maximum": 6 },
              "description": { "type": "string", "minLength": 1 },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "side_effects": { "const": "none" },
              "executed_in_this_phase": { "const": false }
            }
          }
        },
        "reuse_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compatibility_engine", "capability_registry"],
          "properties": {
            "compatibility_engine": { "const": "mandatory_exact_reuse" },
            "capability_registry": { "const": "mandatory_read_only_via_engine" }
          }
        },
        "accept_condition": {
          "const": "registration validation accepted and record written"
        },
        "reject_condition": {
          "const": "one or more registration rejection codes emitted"
        }
      }
    },
    "registration_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "description",
        "encoding",
        "required_fields",
        "optional_fields",
        "identity_policy",
        "uniqueness",
        "additional_fields"
      ],
      "properties": {
        "schema_id": { "const": "dsc-backend-adapter-registration-record-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "required_fields": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "optional_fields": { "type": "array", "maxItems": 0 },
        "identity_policy": {
          "const": "opaque_registration_id_no_vendor_binding"
        },
        "uniqueness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unique_on", "duplicate_policy", "duplicate_code"],
          "properties": {
            "unique_on": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "const": "backend_id" },
                { "const": "adapter_interface_version" },
                { "const": "capability_set_version" }
              ]
            },
            "duplicate_policy": {
              "const": "reject_duplicate_active_registration"
            },
            "duplicate_code": {
              "const": "DSC_BACKEND_REGISTRATION_DUPLICATE_ACTIVE"
            }
          }
        },
        "additional_fields": { "const": false }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_id",
        "description",
        "states",
        "initial_state",
        "active_state",
        "terminal_state",
        "transitions",
        "invariants",
        "registers_adapters_in_this_phase"
      ],
      "properties": {
        "lifecycle_id": {
          "const": "dsc-backend-adapter-registration-lifecycle-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "const": "pending" },
            { "const": "active" },
            { "const": "suspended" },
            { "const": "deregistered" }
          ]
        },
        "initial_state": { "const": "pending" },
        "active_state": { "const": "active" },
        "terminal_state": { "const": "deregistered" },
        "transitions": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "trigger",
              "requires_compatibility_recheck",
              "allowed"
            ],
            "properties": {
              "from": {
                "enum": ["pending", "active", "suspended", "deregistered"]
              },
              "to": {
                "enum": ["pending", "active", "suspended", "deregistered"]
              },
              "trigger": { "type": "string", "minLength": 1 },
              "requires_compatibility_recheck": { "type": "boolean" },
              "allowed": { "const": true }
            }
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "registers_adapters_in_this_phase": { "const": false }
      }
    },
    "deregistration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "description",
        "allowed_reasons",
        "effects",
        "forbidden",
        "irreversible",
        "executed_in_this_phase"
      ],
      "properties": {
        "policy_id": {
          "const": "dsc-backend-adapter-deregistration-policy-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "allowed_reasons": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            { "const": "caller_requested" },
            { "const": "capability_set_major_mismatch" },
            { "const": "compatibility_revoked" },
            { "const": "lifecycle_expired" },
            { "const": "policy_violation" }
          ]
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lifecycle_state_becomes",
            "registration_record_retained",
            "re_registration_policy",
            "binding_handles_released"
          ],
          "properties": {
            "lifecycle_state_becomes": { "const": "deregistered" },
            "registration_record_retained": { "const": true },
            "re_registration_policy": {
              "const": "requires_new_registration_flow_and_fresh_compatibility_report"
            },
            "binding_handles_released": { "const": true }
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "irreversible": { "const": true },
        "executed_in_this_phase": { "const": false }
      }
    },
    "registration_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "description",
        "evaluation",
        "accept_condition",
        "outcome_values",
        "checks",
        "requires_compatible_engine_outcome",
        "evaluates_registrations_in_this_phase"
      ],
      "properties": {
        "validation_id": {
          "const": "dsc-backend-adapter-registration-validation-v1"
        },
        "description": { "type": "string", "minLength": 1 },
        "evaluation": { "const": "collect_all_rejections" },
        "accept_condition": {
          "const": "zero rejection codes and compatibility outcome compatible"
        },
        "outcome_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "accepted" }, { "const": "rejected" }]
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "stage_ref",
              "description",
              "rejection_code",
              "mandatory"
            ],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "stage_ref": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "rejection_code": {
                "type": "string",
                "pattern": "^DSC_BACKEND_REGISTRATION_[A-Z0-9_]+$"
              },
              "mandatory": { "const": true }
            }
          }
        },
        "requires_compatible_engine_outcome": { "const": true },
        "evaluates_registrations_in_this_phase": { "const": false }
      }
    },
    "registered_adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "registration_policy",
        "registers_adapters_in_this_phase"
      ],
      "properties": {
        "count": { "const": 0 },
        "entries": { "type": "array", "maxItems": 0 },
        "registration_policy": { "type": "string", "minLength": 1 },
        "registers_adapters_in_this_phase": { "const": false }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_only",
        "read_only",
        "backend_agnostic",
        "reuses_compatibility_engine",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "registers_adapters_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "registration_only": { "const": true },
        "read_only": { "const": true },
        "backend_agnostic": { "const": true },
        "reuses_compatibility_engine": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "registers_adapters_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
