    "mode": { "type": "string", "const": "design_only_family" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_BACKEND_FAMILY_V1"
    },
    "family_id": { "const": "dsc-backend-family-generic-v1" },
    "family_version": { "const": "1.0" },
    "family_kind": { "const": "generic_backend_family" },
    "reference_backend_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-reference-backend-v1.json"
