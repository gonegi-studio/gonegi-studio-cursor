        "read_only",
        "backend_agnostic",
        "reuses_certified_reference_backend",
        "no_vendor_specific_implementation",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "instantiates_members_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "family_only": { "const": true },
        "read_only": { "const": true },
        "backend_agnostic": { "const": true },
