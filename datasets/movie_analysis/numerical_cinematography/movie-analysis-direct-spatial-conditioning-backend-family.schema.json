        "capability_registry_ref",
        "profile_capability_mapping_ref",
        "spatial_frame_ref",
        "required_channels",
        "required_sources",
        "adapted_input_shape_ref",
        "required_capabilities",
        "inheritance_rule",
        "aggregation_rule",
        "vendor_specific_capabilities",
        "requires_gpu",
        "performs_inference",
        "evaluates_members_in_this_phase"
