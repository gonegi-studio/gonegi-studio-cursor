          "const": "dsc-backend-capability-contract-v1"
        },
        "capability_registry_ref": {
          "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry-v1.json"
        },
        "profile_capability_mapping_ref": {
          "const": "dsc-backend-profile-deterministic-capability-mapping-v1"
        },
        "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
        "required_channels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_sources": { "type": "integer", "const": 15 },
        "adapted_input_shape_ref": {
          "const": "dsc_adapted_conditioning_input_v1"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "requirement",
              "inherited_from",
              "declared_state_required",
              "family_member_must_declare"
            ],
            "properties": {
              "capability_id": { "type": "string", "minLength": 1 },
              "requirement": { "const": "mandatory" },
