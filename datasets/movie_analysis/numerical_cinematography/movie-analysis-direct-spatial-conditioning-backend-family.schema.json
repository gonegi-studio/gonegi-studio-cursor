          "const": "every_family_member_must_satisfy_all_mandatory_capabilities"
        },
        "aggregation_rule": { "const": "all_mandatory_capabilities_supported" },
        "vendor_specific_capabilities": { "const": "forbidden" },
        "requires_gpu": { "const": false },
        "performs_inference": { "const": false },
        "evaluates_members_in_this_phase": { "const": false }
