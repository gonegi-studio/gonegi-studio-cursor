{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-family.schema.json",
  "title": "DirectSpatialConditioningBackendFamily",
