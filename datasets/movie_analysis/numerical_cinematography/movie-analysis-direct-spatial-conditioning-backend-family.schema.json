        "no_vendor_specific_implementation": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "instantiates_members_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
