{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-runtime-router.schema.json",
  "title": "DirectSpatialConditioningBackendRuntimeRouter",
  "description": "PHASE-DSC-043 design-only, read-only, backend-agnostic runtime router. Defines the backend selection flow, deterministic routing policy, fallback policy, and routing report over the frozen PHASE-042 adapter registration. Selects no backend and performs no GPU, inference, or dataset modification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_router_id",
    "phase",
    "system_id",
    "mode",
    "target",
    "adapter_registration_ref",
    "adapter_registration_phase",
    "adapter_registration_system_id",
    "compatibility_engine_ref",
    "capability_registry_ref",
    "adapter_foundation_ref",
    "runtime_interface_ref",
    "runtime_package_ref",
    "sources_supported",
    "required_channels",
    "spatial_frame_ref",
    "capability_set_id",
    "capability_set_version",
    "selection_flow",
    "deterministic_routing_policy",
    "fallback_policy",
    "routing_report",
    "routed_backends",
    "design_constraints",
    "created_at"
  ],
  "properties": {
    "runtime_router_id": {
      "type": "string",
      "const": "direct-spatial-conditioning-backend-runtime-router-v1"
    },
    "phase": { "type": "string", "const": "PHASE-DSC-043" },
    "system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_RUNTIME_ROUTER_V1"
    },
    "mode": { "type": "string", "const": "design_only_router" },
    "target": {
      "type": "string",
      "const": "PASS_DIRECT_SPATIAL_CONDITIONING_BACKEND_RUNTIME_ROUTER_V1"
    },
    "adapter_registration_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-registration-v1.json"
    },
    "adapter_registration_phase": { "type": "string", "const": "PHASE-DSC-042" },
    "adapter_registration_system_id": {
      "type": "string",
      "const": "DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_REGISTRATION_V1"
    },
    "compatibility_engine_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-compatibility-engine-v1.json"
    },
    "capability_registry_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry-v1.json"
    },
    "adapter_foundation_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-foundation-v1.json"
    },
    "runtime_interface_ref": {
      "type": "string",
      "const": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json"
    },
    "runtime_package_ref": {
      "type": "string",
      "const": "exports/numerical_reconstruction/v1/numerical-reconstruction-runtime-package-v1.json"
    },
    "sources_supported": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_channels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_frame_ref": { "const": "normalized_image_plane_v1" },
    "capability_set_id": { "const": "dsc-backend-capability-set-v1" },
    "capability_set_version": { "const": "1.0" },
    "selection_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "description",
        "ordered_stages",
        "reuse_policy",
        "accept_condition",
        "reject_condition",
        "outcome_values"
      ],
      "properties": {
        "flow_id": { "const": "dsc-backend-selection-flow-v1" },
        "description": { "type": "string", "minLength": 1 },
        "ordered_stages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "order",
              "description",
              "inputs",
              "outputs",
              "side_effects",
              "executed_in_this_phase"
            ],
            "properties": {
              "stage_id": {
                "enum": [
                  "bind_routing_request",
                  "lookup_active_registrations",
                  "filter_eligible_adapters",
                  "rank_candidates",
                  "select_primary_route",
                  "apply_fallback_if_needed",
                  "emit_routing_report"
                ]
              },
              "order": { "type": "integer", "minimum": 1, "maximum": 7 },
              "description": { "type": "string", "minLength": 1 },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "side_effects": { "const": "none" },
              "executed_in_this_phase": { "const": false }
            }
          }
        },
        "reuse_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_registration", "compatibility_engine"],
          "properties": {
            "adapter_registration": { "const": "mandatory_exact_reuse" },
            "compatibility_engine": {
              "const": "mandatory_read_only_via_registration"
            }
          }
        },
        "accept_condition": {
          "const": "routing report outcome is routed or fallback with declared branch"
        },
        "reject_condition": {
          "const": "routing report outcome is unroutable"
        },
        "outcome_values": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "routed" },
            { "const": "fallback" },
            { "const": "unroutable" }
          ]
        }
      }
    },
    "deterministic_routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "description",
        "eligibility",
        "ranking_keys",
        "selection_rule",
        "tie_breakers",
        "purity",
        "seed_dependence",
        "time_dependence",
        "randomness",
        "backend_invocation",
        "selects_backends_in_this_phase"
      ],
      "properties": {
        "policy_id": { "const": "dsc-backend-deterministic-routing-policy-v1" },
        "description": { "type": "string", "minLength": 1 },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lifecycle_state_required",
            "compatibility_outcome_required",
            "capability_set_id_required",
            "spatial_frame_required",
            "channel_coverage_required"
          ],
          "properties": {
            "lifecycle_state_required": { "const": "active" },
            "compatibility_outcome_required": { "const": "compatible" },
            "capability_set_id_required": {
              "const": "dsc-backend-capability-set-v1"
            },
            "spatial_frame_required": { "const": "normalized_image_plane_v1" },
            "channel_coverage_required": { "const": "exact_foundation_order" }
          }
        },
        "ranking_keys": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key_id",
              "order",
              "field",
              "direction",
              "description"
            ],
            "properties": {
              "key_id": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1, "maximum": 4 },
              "field": { "type": "string", "minLength": 1 },
              "direction": { "enum": ["ascending", "descending"] },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "selection_rule": { "const": "first_after_stable_sort" },
        "tie_breakers": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "purity": { "const": "deterministic_pure_function" },
        "seed_dependence": { "const": "none" },
        "time_dependence": { "const": "none" },
        "randomness": { "const": "none" },
        "backend_invocation": { "const": "none" },
        "selects_backends_in_this_phase": { "const": false }
      }
    },
    "fallback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "description",
        "primary_exhausted_behavior",
        "branches",
        "forbidden",
        "never_invents_backend",
        "never_bypasses_registration",
        "executed_in_this_phase"
      ],
      "properties": {
        "policy_id": { "const": "dsc-backend-routing-fallback-policy-v1" },
        "description": { "type": "string", "minLength": 1 },
        "primary_exhausted_behavior": {
          "const": "evaluate_fallback_branches_in_order"
        },
        "branches": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch_id",
              "condition",
              "action",
              "outcome",
              "rejection_or_code"
            ],
            "properties": {
              "branch_id": { "type": "string", "minLength": 1 },
              "condition": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["routed", "fallback", "unroutable"] },
              "rejection_or_code": { "type": ["string", "null"] }
            }
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "never_invents_backend": { "const": true },
        "never_bypasses_registration": { "const": true },
        "executed_in_this_phase": { "const": false }
      }
    },
    "routing_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema_id",
        "report_id",
        "description",
        "encoding",
        "required_fields",
        "outcome_values",
        "candidate_entry_shape",
        "ordering",
        "additional_fields",
        "materializes_tensors",
        "materializes_frames"
      ],
      "properties": {
        "report_schema_id": { "const": "dsc-backend-routing-report-schema-v1" },
        "report_id": { "const": "dsc-backend-routing-report-v1" },
        "description": { "type": "string", "minLength": 1 },
        "encoding": { "const": "application/json" },
        "required_fields": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "type", "required", "nullable", "constraint"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "required": { "const": true },
              "nullable": { "const": false },
              "constraint": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outcome_values": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "routed" },
            { "const": "fallback" },
            { "const": "unroutable" }
          ]
        },
        "candidate_entry_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ordering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates_considered", "rejected_candidates"],
          "properties": {
            "candidates_considered": { "const": "ranking_key_order" },
            "rejected_candidates": { "const": "ranking_key_order" }
          }
        },
        "additional_fields": { "const": false },
        "materializes_tensors": { "const": false },
        "materializes_frames": { "const": false }
      }
    },
    "routed_backends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "entries",
        "routing_policy",
        "routes_backends_in_this_phase"
      ],
      "properties": {
        "count": { "const": 0 },
        "entries": { "type": "array", "maxItems": 0 },
        "routing_policy": { "type": "string", "minLength": 1 },
        "routes_backends_in_this_phase": { "const": false }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router_only",
        "read_only",
        "backend_agnostic",
        "reuses_adapter_registration",
        "backend",
        "no_backend_implementation",
        "gpu",
        "inference",
        "routes_backends_in_this_phase",
        "modifies_existing_datasets",
        "placeholders"
      ],
      "properties": {
        "router_only": { "const": true },
        "read_only": { "const": true },
        "backend_agnostic": { "const": true },
        "reuses_adapter_registration": { "const": true },
        "backend": { "const": "none" },
        "no_backend_implementation": { "const": true },
        "gpu": { "const": false },
        "inference": { "const": false },
        "routes_backends_in_this_phase": { "const": false },
        "modifies_existing_datasets": { "const": false },
        "placeholders": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
