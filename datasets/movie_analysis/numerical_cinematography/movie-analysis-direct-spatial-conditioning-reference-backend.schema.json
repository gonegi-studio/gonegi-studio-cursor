          "const": "exports/direct_spatial_conditioning_backend_certification/v1/direct-spatial-conditioning-backend-profile-certification-v1.json"
        },
        "binding_mode": { "const": "exact_reuse" },
        "capability_mapping_ref": {
          "const": "dsc-backend-profile-deterministic-capability-mapping-v1"
        },
        "adapter_configuration_ref": {
          "const": "dsc-backend-profile-adapter-configuration-v1"
        },
        "profile_validation_ref": {
          "const": "dsc-backend-profile-validation-v1"
        },
        "inherits_capability_declarations": { "const": true },
        "binds_profile_in_this_phase": { "const": true },
        "implements_profile_in_this_phase": { "const": false }
      }
