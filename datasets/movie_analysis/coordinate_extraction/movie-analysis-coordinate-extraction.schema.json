{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/coordinate_extraction/movie-analysis-coordinate-extraction.schema.json",
  "title": "MovieAnalysisCoordinateExtractionPlan",
  "description": "Planning-only coordinate extraction design for PHASE-SOURCE-VIDEO-026",
  "type": "object",
  "required": [
    "coordinate_extraction_id",
    "phase",
    "source_video_id",
    "analysis_plan_id",
    "dry_run_id",
    "sampling_plan_id",
    "scene_detection_id",
    "coordinate_candidate_count",
    "coordinate_extraction_strategy",
    "coordinate_candidates",
    "coordinate_types",
    "coverage_goal",
    "identity_safety",
    "execution_flags",
    "designed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "coordinate_extraction_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-026-MOVIE_ANALYSIS_COORDINATE_EXTRACTION_DESIGN_V1"
    },
    "source_video_id": { "type": "string", "minLength": 1 },
    "analysis_plan_id": { "type": "string", "minLength": 1 },
    "dry_run_id": { "type": "string", "minLength": 1 },
    "sampling_plan_id": { "type": "string", "minLength": 1 },
    "scene_detection_id": { "type": "string", "minLength": 1 },
    "coordinate_candidate_count": { "type": "integer", "minimum": 1 },
    "coordinate_extraction_strategy": {
      "type": "string",
      "enum": [
        "SHOT_GRAMMAR_CANDIDATE",
        "CAMERA_MOTION_CANDIDATE",
        "BLOCKING_CANDIDATE",
        "EMOTION_LOCATION_CANDIDATE"
      ]
    },
    "coordinate_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "scene_candidate_id",
          "coordinate_type",
          "estimated_value",
          "reads_frame",
          "extracts_coordinate",
          "validates_timestamp",
          "candidate_type",
          "estimated_only"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "type": "string" },
          "scene_candidate_id": { "type": "string" },
          "coordinate_type": {
            "type": "string",
            "enum": [
              "shot_scale",
              "camera_angle",
              "camera_motion",
              "subject_position",
              "blocking",
              "location_anchor",
              "lighting_state",
              "emotion_state",
              "transition_hint"
            ]
          },
          "estimated_value": { "type": "string", "minLength": 1 },
          "reads_frame": { "type": "boolean", "const": false },
          "extracts_coordinate": { "type": "boolean", "const": false },
          "validates_timestamp": { "type": "boolean", "const": false },
          "candidate_type": {
            "type": "string",
            "const": "estimated_coordinate_candidate"
          },
          "estimated_only": { "type": "boolean", "const": true }
        }
      }
    },
    "coordinate_types": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "shot_scale",
          "camera_angle",
          "camera_motion",
          "subject_position",
          "blocking",
          "location_anchor",
          "lighting_state",
          "emotion_state",
          "transition_hint"
        ]
      }
    },
    "coverage_goal": {
      "type": "object",
      "required": ["segment_span_seconds", "coverage_percent", "purpose"],
      "additionalProperties": false,
      "properties": {
        "segment_span_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "purpose": {
          "type": "string",
          "const": "future_gonegi_state_mapping_preparation"
        }
      }
    },
    "identity_safety": {
      "type": "object",
      "required": [
        "identity_lock_required",
        "character_first_contract",
        "estimated_only",
        "no_coordinate_extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_lock_required": { "type": "boolean", "const": true },
        "character_first_contract": { "type": "boolean", "const": true },
        "estimated_only": { "type": "boolean", "const": true },
        "no_coordinate_extraction": { "type": "boolean", "const": true }
      }
    },
    "execution_flags": {
      "type": "object",
      "required": [
        "planning_only",
        "gpu_execution",
        "external_call_allowed",
        "coordinate_extraction",
        "frame_extraction",
        "scene_extraction",
        "ocr"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false },
        "coordinate_extraction": { "type": "boolean", "const": false },
        "frame_extraction": { "type": "boolean", "const": false },
        "scene_extraction": { "type": "boolean", "const": false },
        "ocr": { "type": "boolean", "const": false }
      }
    },
    "designed_at": { "type": "string", "format": "date-time" }
  }
}
