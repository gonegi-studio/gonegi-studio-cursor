{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/frame_sampling/movie-analysis-frame-sampling.schema.json",
  "title": "MovieAnalysisFrameSamplingPlan",
  "description": "Planning-only frame sampling design for PHASE-SOURCE-VIDEO-024",
  "type": "object",
  "required": [
    "sampling_plan_id",
    "phase",
    "source_video_id",
    "analysis_plan_id",
    "dry_run_id",
    "sampling_strategy",
    "target_frame_count",
    "sampling_points",
    "coverage_goal",
    "identity_safety",
    "execution_flags",
    "designed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "sampling_plan_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-024-MOVIE_ANALYSIS_FRAME_SAMPLING_DESIGN_V1"
    },
    "source_video_id": { "type": "string", "minLength": 1 },
    "analysis_plan_id": { "type": "string", "minLength": 1 },
    "dry_run_id": { "type": "string", "minLength": 1 },
    "sampling_strategy": {
      "type": "string",
      "enum": [
        "START_MIDDLE_END",
        "UNIFORM_INTERVAL",
        "EMOTION_PEAK_CANDIDATE",
        "TRANSITION_CANDIDATE"
      ]
    },
    "target_frame_count": { "type": "integer", "minimum": 1 },
    "sampling_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "point_id",
          "timestamp_seconds",
          "point_role",
          "reads_frame",
          "saves_image",
          "candidate_type"
        ],
        "additionalProperties": false,
        "properties": {
          "point_id": { "type": "string" },
          "timestamp_seconds": { "type": "number", "minimum": 0 },
          "point_role": {
            "type": "string",
            "enum": [
              "start_anchor",
              "middle_anchor",
              "end_anchor",
              "uniform_interval",
              "emotion_peak",
              "transition_in",
              "transition_out",
              "scene_detection_prep"
            ]
          },
          "reads_frame": { "type": "boolean", "const": false },
          "saves_image": { "type": "boolean", "const": false },
          "candidate_type": {
            "type": "string",
            "const": "timestamp_candidate"
          }
        }
      }
    },
    "coverage_goal": {
      "type": "object",
      "required": ["segment_span_seconds", "coverage_percent", "purpose"],
      "additionalProperties": false,
      "properties": {
        "segment_span_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "purpose": {
          "type": "string",
          "const": "future_scene_detection_preparation"
        }
      }
    },
    "identity_safety": {
      "type": "object",
      "required": [
        "identity_lock_required",
        "character_first_contract",
        "timestamp_only",
        "no_image_assets"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_lock_required": { "type": "boolean", "const": true },
        "character_first_contract": { "type": "boolean", "const": true },
        "timestamp_only": { "type": "boolean", "const": true },
        "no_image_assets": { "type": "boolean", "const": true }
      }
    },
    "execution_flags": {
      "type": "object",
      "required": [
        "planning_only",
        "gpu_execution",
        "external_call_allowed",
        "frame_extraction",
        "ocr",
        "generation"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false },
        "frame_extraction": { "type": "boolean", "const": false },
        "ocr": { "type": "boolean", "const": false },
        "generation": { "type": "boolean", "const": false }
      }
    },
    "designed_at": { "type": "string", "format": "date-time" }
  }
}
