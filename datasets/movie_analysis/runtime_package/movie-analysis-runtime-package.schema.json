{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/runtime_package/movie-analysis-runtime-package.schema.json",
  "title": "MovieAnalysisRuntimePackagePlan",
  "description": "Planning-only runtime package design for PHASE-SOURCE-VIDEO-034",
  "type": "object",
  "required": [
    "runtime_package_id",
    "phase",
    "video_blueprint_id",
    "source_video_id",
    "scene_package",
    "character_package",
    "camera_package",
    "emotion_package",
    "transition_package",
    "runtime_readiness",
    "execution_flags",
    "designed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "runtime_package_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-034-MOVIE_ANALYSIS_RUNTIME_PACKAGE_DESIGN_V1"
    },
    "video_blueprint_id": { "type": "string", "minLength": 1 },
    "source_video_id": { "type": "string", "minLength": 1 },
    "scene_package": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "character_package": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "camera_package": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "emotion_package": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "transition_package": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_element" }
    },
    "runtime_readiness": {
      "type": "object",
      "required": [
        "estimated_only",
        "runtime_execution",
        "generates_video",
        "gpu_ready",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "estimated_only": { "type": "boolean", "const": true },
        "runtime_execution": { "type": "boolean", "const": false },
        "generates_video": { "type": "boolean", "const": false },
        "gpu_ready": { "type": "boolean", "const": false },
        "purpose": {
          "type": "string",
          "const": "future_runtime_package_preparation"
        }
      }
    },
    "execution_flags": {
      "type": "object",
      "required": [
        "planning_only",
        "runtime_execution",
        "video_generation",
        "gpu_execution",
        "ocr",
        "external_call_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "runtime_execution": { "type": "boolean", "const": false },
        "video_generation": { "type": "boolean", "const": false },
        "gpu_execution": { "type": "boolean", "const": false },
        "ocr": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false }
      }
    },
    "designed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "package_element": {
      "type": "object",
      "required": [
        "element_id",
        "source_blueprint_element_ids",
        "estimated_runtime_value",
        "package_only"
      ],
      "additionalProperties": false,
      "properties": {
        "element_id": { "type": "string" },
        "source_blueprint_element_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "estimated_runtime_value": { "type": "string", "minLength": 1 },
        "package_only": { "type": "boolean", "const": true }
      }
    }
  }
}
