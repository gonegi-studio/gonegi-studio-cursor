{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/gonegi_state_mapping/movie-analysis-gonegi-state-mapping.schema.json",
  "title": "MovieAnalysisGonegiStateMappingPlan",
  "description": "Planning-only Gonegi state mapping design for PHASE-SOURCE-VIDEO-027",
  "type": "object",
  "required": [
    "gonegi_state_mapping_id",
    "phase",
    "source_video_id",
    "analysis_plan_id",
    "dry_run_id",
    "sampling_plan_id",
    "scene_detection_id",
    "coordinate_extraction_id",
    "state_candidate_count",
    "mapping_strategy",
    "source_coordinates",
    "gonegi_states",
    "state_categories",
    "identity_safety",
    "execution_flags",
    "designed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "gonegi_state_mapping_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-027-MOVIE_ANALYSIS_GONEGI_STATE_MAPPING_DESIGN_V1"
    },
    "source_video_id": { "type": "string", "minLength": 1 },
    "analysis_plan_id": { "type": "string", "minLength": 1 },
    "dry_run_id": { "type": "string", "minLength": 1 },
    "sampling_plan_id": { "type": "string", "minLength": 1 },
    "scene_detection_id": { "type": "string", "minLength": 1 },
    "coordinate_extraction_id": { "type": "string", "minLength": 1 },
    "state_candidate_count": { "type": "integer", "minimum": 1 },
    "mapping_strategy": {
      "type": "string",
      "enum": [
        "WORLD_TRANSLATION_CANDIDATE",
        "CHARACTER_REPLACEMENT_CANDIDATE",
        "EMOTION_TRANSLATION_CANDIDATE",
        "SCENE_STATE_CANDIDATE"
      ]
    },
    "source_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "coordinate_candidate_id",
          "scene_candidate_id",
          "coordinate_type",
          "estimated_value"
        ],
        "additionalProperties": false,
        "properties": {
          "coordinate_candidate_id": { "type": "string" },
          "scene_candidate_id": { "type": "string" },
          "coordinate_type": {
            "type": "string",
            "enum": [
              "shot_scale",
              "camera_angle",
              "camera_motion",
              "subject_position",
              "blocking",
              "location_anchor",
              "lighting_state",
              "emotion_state",
              "transition_hint"
            ]
          },
          "estimated_value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gonegi_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "source_coordinate_id",
          "state_category",
          "estimated_state_value",
          "executes_state",
          "creates_runtime_payload",
          "candidate_type",
          "estimated_only"
        ],
        "additionalProperties": false,
        "properties": {
          "state_id": { "type": "string" },
          "source_coordinate_id": { "type": "string" },
          "state_category": {
            "type": "string",
            "enum": [
              "environment_state",
              "character_state",
              "emotion_state",
              "camera_state",
              "lighting_state",
              "relationship_state",
              "crowd_state",
              "animal_state",
              "transition_state"
            ]
          },
          "estimated_state_value": { "type": "string", "minLength": 1 },
          "executes_state": { "type": "boolean", "const": false },
          "creates_runtime_payload": { "type": "boolean", "const": false },
          "candidate_type": {
            "type": "string",
            "const": "estimated_gonegi_state_candidate"
          },
          "estimated_only": { "type": "boolean", "const": true }
        }
      }
    },
    "state_categories": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "environment_state",
          "character_state",
          "emotion_state",
          "camera_state",
          "lighting_state",
          "relationship_state",
          "crowd_state",
          "animal_state",
          "transition_state"
        ]
      }
    },
    "identity_safety": {
      "type": "object",
      "required": [
        "identity_lock_required",
        "character_first_contract",
        "estimated_only",
        "no_state_execution"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_lock_required": { "type": "boolean", "const": true },
        "character_first_contract": { "type": "boolean", "const": true },
        "estimated_only": { "type": "boolean", "const": true },
        "no_state_execution": { "type": "boolean", "const": true }
      }
    },
    "execution_flags": {
      "type": "object",
      "required": [
        "planning_only",
        "state_mapping_only",
        "gpu_execution",
        "external_call_allowed",
        "coordinate_extraction",
        "frame_extraction",
        "scene_extraction",
        "ocr"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "state_mapping_only": { "type": "boolean", "const": true },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false },
        "coordinate_extraction": { "type": "boolean", "const": false },
        "frame_extraction": { "type": "boolean", "const": false },
        "scene_extraction": { "type": "boolean", "const": false },
        "ocr": { "type": "boolean", "const": false }
      }
    },
    "designed_at": { "type": "string", "format": "date-time" }
  }
}
