{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/movie-analysis-dataset.schema.json",
  "title": "MovieAnalysisDataset",
  "description": "Unified movie analysis dataset export for PHASE-SOURCE-VIDEO-045",
  "type": "object",
  "required": [
    "dataset_id",
    "dataset_version",
    "created_at",
    "source_count",
    "sources",
    "image_app_payloads",
    "video_app_payloads",
    "package_traces",
    "chain_ids",
    "safety_flags"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-045-MOVIE_ANALYSIS_DATASET_EXPORT_V1"
    },
    "created_at": { "type": "string", "minLength": 1 },
    "source_count": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_video_id",
          "source_video_path",
          "master_package_id",
          "final_runtime_bundle_id",
          "generation_blueprint_id"
        ],
        "additionalProperties": false,
        "properties": {
          "source_video_id": { "type": "string", "minLength": 1 },
          "source_video_path": { "type": "string", "minLength": 1 },
          "master_package_id": { "type": "string", "minLength": 1 },
          "final_runtime_bundle_id": { "type": "string", "minLength": 1 },
          "generation_blueprint_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "image_app_payloads": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "video_app_payloads": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "package_traces": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 17,
        "items": { "type": "object" }
      }
    },
    "chain_ids": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "safety_flags": {
      "type": "object",
      "required": ["per_source", "summary"],
      "additionalProperties": false,
      "properties": {
        "per_source": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "summary": {
          "type": "object",
          "required": [
            "planning_only",
            "runtime_execution",
            "video_generation",
            "image_generation",
            "gpu_execution",
            "ocr",
            "external_call_allowed"
          ],
          "properties": {
            "planning_only": { "const": true },
            "runtime_execution": { "const": false },
            "video_generation": { "const": false },
            "image_generation": { "const": false },
            "gpu_execution": { "const": false },
            "ocr": { "const": false },
            "external_call_allowed": { "const": false }
          }
        }
      }
    }
  }
}
