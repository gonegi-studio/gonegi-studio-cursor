{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/movie_analysis/sequence_assembly/movie-analysis-sequence-assembly.schema.json",
  "title": "MovieAnalysisSequenceAssemblyPlan",
  "description": "Planning-only sequence assembly design for PHASE-SOURCE-VIDEO-032",
  "type": "object",
  "required": [
    "sequence_assembly_id",
    "phase",
    "source_video_id",
    "temporal_flow_id",
    "sequence_candidate_count",
    "assembly_strategy",
    "sequence_candidates",
    "sequence_categories",
    "coverage_goal",
    "identity_safety",
    "execution_flags",
    "designed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "sequence_assembly_id": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "const": "PHASE-SOURCE-VIDEO-032-MOVIE_ANALYSIS_SEQUENCE_ASSEMBLY_DESIGN_V1"
    },
    "source_video_id": { "type": "string", "minLength": 1 },
    "temporal_flow_id": { "type": "string", "minLength": 1 },
    "sequence_candidate_count": { "type": "integer", "minimum": 1 },
    "assembly_strategy": {
      "type": "string",
      "enum": [
        "SEQUENCE_CHAIN_PLAN",
        "CONTINUITY_ASSEMBLY_PLAN",
        "EMOTION_SEQUENCE_PLAN",
        "TRANSITION_SEQUENCE_PLAN"
      ]
    },
    "sequence_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence_candidate_id",
          "temporal_candidate_id",
          "sequence_category",
          "estimated_sequence_value",
          "generates_sequence",
          "generates_video",
          "candidate_type",
          "estimated_only"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence_candidate_id": { "type": "string" },
          "temporal_candidate_id": { "type": "string" },
          "sequence_category": {
            "type": "string",
            "enum": [
              "sequence_chain",
              "continuity_chain",
              "emotion_chain",
              "camera_chain",
              "environment_chain",
              "character_chain",
              "crowd_chain",
              "transition_chain",
              "timing_chain"
            ]
          },
          "estimated_sequence_value": { "type": "string", "minLength": 1 },
          "generates_sequence": { "type": "boolean", "const": false },
          "generates_video": { "type": "boolean", "const": false },
          "candidate_type": {
            "type": "string",
            "const": "estimated_sequence_candidate"
          },
          "estimated_only": { "type": "boolean", "const": true }
        }
      }
    },
    "sequence_categories": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "sequence_chain",
          "continuity_chain",
          "emotion_chain",
          "camera_chain",
          "environment_chain",
          "character_chain",
          "crowd_chain",
          "transition_chain",
          "timing_chain"
        ]
      }
    },
    "coverage_goal": {
      "type": "object",
      "required": ["segment_span_seconds", "coverage_percent", "purpose"],
      "additionalProperties": false,
      "properties": {
        "segment_span_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "purpose": {
          "type": "string",
          "const": "future_video_sequence_preparation"
        }
      }
    },
    "identity_safety": {
      "type": "object",
      "required": [
        "identity_lock_required",
        "character_first_contract",
        "estimated_only",
        "no_sequence_generation"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_lock_required": { "type": "boolean", "const": true },
        "character_first_contract": { "type": "boolean", "const": true },
        "estimated_only": { "type": "boolean", "const": true },
        "no_sequence_generation": { "type": "boolean", "const": true }
      }
    },
    "execution_flags": {
      "type": "object",
      "required": [
        "planning_only",
        "sequence_assembly_only",
        "sequence_generation",
        "video_generation",
        "gpu_execution",
        "external_call_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_only": { "type": "boolean", "const": true },
        "sequence_assembly_only": { "type": "boolean", "const": true },
        "sequence_generation": { "type": "boolean", "const": false },
        "video_generation": { "type": "boolean", "const": false },
        "gpu_execution": { "type": "boolean", "const": false },
        "external_call_allowed": { "type": "boolean", "const": false }
      }
    },
    "designed_at": { "type": "string", "format": "date-time" }
  }
}
