{
  "asset_type": "music_drama_grammar",
  "asset_version": "v1",
  "grammar_id": "music-drama-grammar-v1",
  "phase": "PHASE-MDG-001",
  "world_identity": "GONEGI_MEDITERRANEAN",
  "world_type": "early-1900s mediterranean harbor town",
  "purpose": "Formal grammar layer for Music Drama scenario writing. Defines structural rules and composition contracts without generating scenarios.",
  "scope": {
    "generates_scenarios": false,
    "generates_prompts": false,
    "modifies_existing_datasets": false
  },
  "read_only_sources": {
    "master_story": "datasets/story/music-drama-master-story-v1.json",
    "scenario_rulebook": "datasets/music_drama/music-drama-scenario-writing-rulebook-v1.json",
    "render_feedback": "datasets/render_feedback/RKB-001.json",
    "shot_patterns": "datasets/music_drama_grammar/music-drama-shot-patterns-v1.json",
    "scene_archetypes": "datasets/music_drama_grammar/music-drama-scene-archetypes-v1.json"
  },
  "narrative_foundation": {
    "series_title": "지중해 연대기 - 연작 뮤직비디오 시리즈",
    "genre": "music drama fantasy romance",
    "default_narrative_lens": "protagonist POV — camera follows the active lead character's visual attention",
    "emotional_arc_style": "lyric-driven still moments with readable emotional residue between scenes"
  },
  "field_contract": {
    "scenario_field": {
      "must_contain": [
        "location",
        "atmosphere",
        "visible environment",
        "visible actions",
        "scene context"
      ],
      "must_be": [
        "cinematic",
        "visual",
        "music-drama compatible",
        "one primary location",
        "one primary action",
        "emotionally readable"
      ],
      "forbidden": [
        "character visual descriptions",
        "plot summaries",
        "exposition",
        "internal monologue",
        "excessive action stacking",
        "negative exclusion phrases"
      ]
    },
    "character_field": {
      "must_contain": [
        "visible main characters",
        "visible supporting characters",
        "visible extras",
        "visible crowd groups",
        "visible animals",
        "visual descriptions only"
      ],
      "description_must_include": [
        "identity",
        "age (if known)",
        "appearance",
        "clothing",
        "key visual traits"
      ],
      "forbidden": [
        "location descriptions",
        "story narration",
        "action sentences",
        "camera instructions",
        "lighting descriptions",
        "absent characters",
        "actions",
        "emotions",
        "scene descriptions"
      ]
    },
    "separation_required": true,
    "absent_character_rule": "omit only — never write exclusion phrases such as \"No Dana\" or \"Dana absent\""
  },
  "density_limits": {
    "source": "RKB-001 early image test validation",
    "max_named_extras": 2,
    "max_crowd_groups": 1,
    "max_animals": 2,
    "crowd_role": "background support only",
    "protagonist_dominance": "crowd must never compete with protagonist visibility"
  },
  "continuity_grammar": {
    "track": [
      "persistent_object",
      "persistent_companion",
      "persistent_weather",
      "persistent_emotion"
    ],
    "companion_rule": "companion animals remain present across adjacent scenes until departure is explicitly described in scenario",
    "object_rule": "held or carried objects persist until scenario explicitly removes them",
    "weather_rule": "time and weather must align with datasets/time/time-setting-library-v1.json"
  },
  "emotional_grammar": {
    "music_drama_registers": [
      {
        "register_id": "peaceful_daily_life",
        "labels": ["peace", "warmth", "ordinary happiness"],
        "compatible_episodes": ["EP01"],
        "shot_pattern_affinity": ["establishing_daily_life", "domestic_warmth", "companion_bond_moment"]
      },
      {
        "register_id": "family_comfort",
        "labels": ["family comfort", "quiet hope"],
        "compatible_episodes": ["EP01"],
        "shot_pattern_affinity": ["domestic_warmth", "bakery_morning"]
      },
      {
        "register_id": "small_freedom",
        "labels": ["small freedom", "quiet hope"],
        "compatible_episodes": ["EP01"],
        "shot_pattern_affinity": ["street_passage", "harbor_edge_watch", "rooftop_gaze"]
      },
      {
        "register_id": "longing_distance",
        "labels": ["longing", "separation", "quiet sorrow"],
        "compatible_episodes": ["EP02+"],
        "shot_pattern_affinity": ["quiet_solitude", "harbor_edge_watch"]
      },
      {
        "register_id": "reunion_hope",
        "labels": ["reunion", "relief", "tender joy"],
        "compatible_episodes": ["EP03+"],
        "shot_pattern_affinity": ["companion_bond_moment", "establishing_daily_life"]
      }
    ]
  },
  "time_atmosphere_binding": {
    "reference_library": "datasets/time/time-setting-library-v1.json",
    "rule": "scenario atmosphere must not contradict selected timeSetting cluster",
    "clusters": {
      "sunrise": ["warm low-angle light", "long shadows", "morning atmosphere"],
      "sunset": ["warm fading light", "evening atmosphere"],
      "rain": ["cloud cover", "wet surfaces", "reduced visibility"]
    }
  },
  "visual_anchor_grammar": {
    "purpose": "recurring anchors improve image consistency across Music Drama scenes",
    "anchors": [
      "bakery window",
      "harbor bench",
      "olive tree",
      "fishing pier",
      "stone staircase"
    ],
    "reuse_rule": "prefer repeating compatible anchors within the same episode"
  },
  "rkb_validated_findings": {
    "test_id": "RKB-001",
    "validated_structure": {
      "scenario_character_separation": true,
      "negative_exclusion_tokens": false
    },
    "pass_observations": [
      "character consistency improved with external manual scenario",
      "Gonegi identity stable",
      "Gamja identity stable",
      "scenario/character separation effective"
    ],
    "known_risk_zones": [
      {
        "risk_id": "dense_market_crowd",
        "severity": "MEDIUM",
        "mitigation": "limit crowd groups and named extras per density_limits"
      },
      {
        "risk_id": "bedroom_object_merge",
        "severity": "LOW",
        "mitigation": "keep bedding and body contact visually simple in domestic scenes"
      },
      {
        "risk_id": "hand_artifacts",
        "severity": "LOW",
        "mitigation": "avoid complex hand poses in early test phases"
      }
    ]
  },
  "grammar_modules": {
