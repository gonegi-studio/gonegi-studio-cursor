    "recommended_expansion_priority": [
      "Music Drama Grammar",
      "Daily Life Grammar",
      "Crowd Grammar",
      "Animal Behavior Grammar"
    ]
  },
  "generator_readiness": {
    "automatic_scenario_generation": false,
    "requires": [
      "rulebook compliance",
      "manual scenario validation",
      "image test pass",
      "grammar layer present"
    ]
  }
