  "section_3_scene_count_expansion_rule": {
    "base_beat_count": 6,
    "allowed_expansions": [10, 15, 30],
    "rules": [
      "Do not invent new emotional jumps.",
      "Repeat compatible motifs across expanded scenes.",
      "Preserve continuity companion across adjacent scenes.",
      "Preserve protagonist readability in every expanded slot.",
      "Expansion inserts intermediate scenes between beats using allowed emotional transitions only.",
      "Each expanded scene must complete the full assembly pipeline in section_1 order."
    ],
    "expansion_method": "subdivide beats with compatible daily-life behaviors and matching shot/archetype pairs from existing grammar libraries"
  },
  "section_4_continuity_state_transfer": {
    "tracked_fields": [
      "persistent_companion",
      "persistent_object",
      "persistent_location_anchor",
      "persistent_emotion",
      "persistent_time_cluster"
    ],
    "companion_rules": {
      "gonegi_gamja": "Gamja persists with Gonegi across adjacent EP01 scenes unless departure is explicitly described.",
      "dana_aengdu": "Aengdu persists with Dana only when Dana appears in future episodes."
    },
    "object_rule": "Carried objects such as toast persist until scenario explicitly removes them.",
    "location_anchor_rule": "Recurring anchors such as window and harbor_bench may reappear to strengthen motif continuity.",
    "time_cluster_rule": "Time atmosphere must stay compatible with datasets/time/time-setting-library-v1.json"
  },
  "section_5_field_separation_output_contract": {
    "when_converted_to_image_app": true,
    "scenario_field_receives": [
      "location",
      "atmosphere",
      "visible environment",
      "visible action"
    ],
    "character_field_receives": [
      "only visible entity descriptions"
    ],
    "forbidden": [
      "absent character names",
      "negative exclusion text"
    ],
    "alignment": "music-drama-scenario-writing-rulebook-v1 field_separation_law"
  },
