{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datasets/video_runtime/provider.schema.json",
  "title": "VideoRuntimeProvider",
  "description": "Provider abstraction stub for PHASE-25 video runtime provider registry",
  "type": "object",
  "required": [
    "provider_id",
    "provider_type",
    "runtime_mode",
    "status",
    "supported_inputs",
    "supported_outputs",
    "capabilities",
    "limitations",
    "execution_flags",
    "wiring"
  ],
  "additionalProperties": false,
  "properties": {
    "provider_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "const": "PHASE-25-VIDEO-RUNTIME-PROVIDER-ABSTRACTION-001" },
    "provider_type": { "type": "string", "enum": ["local", "remote"] },
    "runtime_mode": { "type": "string", "enum": ["stub", "preparation_only"] },
    "status": { "type": "string", "const": "not_wired" },
    "supported_inputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "supported_outputs": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "execution_flags": { "$ref": "#/$defs/execution_flags" },
    "wiring": { "$ref": "#/$defs/wiring" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "execution_flags": {
      "type": "object",
      "required": ["gpu_execution", "preparation_only", "external_call_allowed"],
      "additionalProperties": false,
      "properties": {
        "gpu_execution": { "type": "boolean", "const": false },
        "preparation_only": { "type": "boolean", "const": true },
        "external_call_allowed": { "type": "boolean", "const": false }
      }
    },
    "wiring": {
      "type": "object",
      "required": ["executable", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "executable": { "type": "null" },
        "endpoint": { "type": "null" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "max_duration_seconds",
        "max_fps",
        "max_resolution",
        "identity_lock_preservation",
        "motion_segment_support",
        "keyframe_interpolation"
      ],
      "properties": {
        "max_duration_seconds": { "type": "number", "minimum": 1 },
        "max_fps": { "type": "number", "minimum": 1 },
        "max_resolution": { "type": "string" },
        "identity_lock_preservation": { "type": "boolean" },
        "motion_segment_support": { "type": "boolean" },
        "keyframe_interpolation": { "type": "boolean" },
        "local_gpu_required": { "type": "boolean" },
        "remote_api": { "type": "boolean" },
        "motion_complexity_tier": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    }
  }
}
