{
  "adapter_registration_id": "direct-spatial-conditioning-backend-adapter-registration-v1",
  "phase": "PHASE-DSC-042",
  "system_id": "DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_REGISTRATION_V1",
  "mode": "design_only_registration",
  "target": "PASS_DIRECT_SPATIAL_CONDITIONING_BACKEND_ADAPTER_REGISTRATION_V1",
  "compatibility_engine_ref": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-compatibility-engine-v1.json",
  "compatibility_engine_phase": "PHASE-DSC-041",
  "compatibility_engine_system_id": "DIRECT_SPATIAL_CONDITIONING_BACKEND_COMPATIBILITY_ENGINE_V1",
  "capability_registry_ref": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-capability-registry-v1.json",
  "adapter_foundation_ref": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-adapter-foundation-v1.json",
  "runtime_interface_ref": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-runtime-interface-v1.json",
