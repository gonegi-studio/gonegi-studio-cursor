{
  "runtime_router_id": "direct-spatial-conditioning-backend-runtime-router-v1",
  "phase": "PHASE-DSC-043",
  "system_id": "DIRECT_SPATIAL_CONDITIONING_BACKEND_RUNTIME_ROUTER_V1",
