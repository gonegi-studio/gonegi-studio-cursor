  "runtime_profile_catalog_schema": {
    "schema_id": "dsc-vendor-runtime-profile-catalog-schema-v1",
    "description": "Shape of a Direct Spatial Conditioning vendor runtime profile catalog. Identity is opaque and vendor-neutral; no vendor name, framework, or device binding is expressed. A runtime profile catalog binds one Vendor Runtime Profile Index as its root, seals the profile index together with its schema and implementation registry, and seals the profile index contents transitively through the runtime profile index digest. It defines no concrete profile catalog runtime and declares no runtime execution.",
    "encoding": "application/json",
    "runtime_profile_catalog_id_policy": "opaque_runtime_profile_catalog_id_no_vendor_binding",
    "runtime_profile_index_ref": "dsc-vendor-runtime-profile-index-v1",
    "required_fields": [
      {
        "field": "runtime_profile_catalog_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "non-empty opaque identifier; carries no vendor name, framework, or device semantics"
      },
      {
        "field": "runtime_profile_catalog_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "major_minor runtime profile catalog version string"
      },
      {
        "field": "runtime_profile_catalog_kind",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal vendor_runtime_profile_catalog"
      },
      {
        "field": "runtime_profile_index_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must reference the vendor runtime profile index dsc-vendor-runtime-profile-index-v1"
      },
      {
        "field": "capability_set_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal dsc-backend-capability-set-v1"
      },
      {
        "field": "capability_set_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal 1.0"
      },
      {
        "field": "spatial_frame_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal normalized_image_plane_v1"
      },
      {
        "field": "required_channels",
        "type": "array<string>",
        "required": true,
        "nullable": false,
        "constraint": "must equal the six foundation channels in fixed order"
      },
      {
        "field": "deterministic_runtime_profile_catalog_identity",
        "type": "dsc-vendor-runtime-profile-catalog-deterministic-identity-v1",
        "required": true,
        "nullable": false,
        "constraint": "opaque deterministic identity with no seed, time, randomness, vendor name, framework, or device dependence"
      },
      {
        "field": "vendor_runtime_profile_index_binding",
        "type": "dsc-vendor-runtime-profile-catalog-profile-index-binding-v1",
        "required": true,
        "nullable": false,
        "constraint": "exact reuse of the passing Vendor Runtime Profile Index as the runtime profile catalog root, gated on its recorded PASS verdict"
      },
      {
        "field": "runtime_profile_catalog_composition",
        "type": "dsc-vendor-runtime-profile-catalog-composition-v1",
        "required": true,
        "nullable": false,
        "constraint": "closed, fixed-order set of runtime profile index artifact, schema, and implementation registry sections; vendor-specific sections forbidden and profile index contents never re-listed"
      },
      {
        "field": "runtime_profile_catalog_manifest",
        "type": "dsc-vendor-runtime-profile-catalog-manifest-v1",
        "required": true,
        "nullable": false,
        "constraint": "content-addressed SHA256 manifest with one entry per section, plus the transitively sealed runtime profile index digest and a runtime profile catalog digest over sections and that digest"
      }
    ],
    "optional_fields": [],
    "additional_fields": false
  },
