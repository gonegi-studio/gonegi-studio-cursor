    "requires_routed_outcome": true,
    "additional_fields": false
  },
  "execution_response": {
    "response_schema_id": "dsc-vendor-execution-response-v1",
    "description": "Shape of one vendor execution response. Outcomes are succeeded, failed, or cancelled; response emission materializes no tensors or frames.",
    "encoding": "application/json",
    "required_fields": [
      {
        "field": "execution_id",
        "type": "string",
        "required": true,
        "nullable": false,
