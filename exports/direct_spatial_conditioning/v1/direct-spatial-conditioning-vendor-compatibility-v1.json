        "pass_condition": "vendor_capability_interface_ref equals dsc-vendor-capability-interface-v1",
        "fail_code": "DSC_VENDOR_COMPAT_FAIL_CAPABILITY_INTERFACE",
        "mandatory": true,
        "deterministic": true,
        "evaluated_in_this_phase": false
