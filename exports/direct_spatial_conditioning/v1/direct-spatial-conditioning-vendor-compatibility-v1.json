        "pass_condition": "vendor_profile_id equals dsc-vendor-profile-generic-v1",
        "fail_code": "DSC_VENDOR_COMPAT_FAIL_PROFILE_BINDING",
        "mandatory": true,
        "deterministic": true,
        "evaluated_in_this_phase": false
      },
