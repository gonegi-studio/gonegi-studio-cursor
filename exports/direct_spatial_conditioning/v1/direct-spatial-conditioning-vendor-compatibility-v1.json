        "mandatory": true,
        "deterministic": true,
        "evaluated_in_this_phase": false
      },
      {
        "rule_id": "RULE_CAPABILITY_SET_LOCKED",
        "order": 4,
        "category": "capability",
        "description": "Declared capability set must match the frozen capability set identity and version.",
        "pass_condition": "capability_set_id equals dsc-backend-capability-set-v1 and capability_set_version equals 1.0",
