      {
        "field": "vendor_profile_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal 1.0"
      },
      {
        "field": "lifecycle_state",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must be one of vendor_lifecycle.states"
      },
      {
        "field": "capability_set_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal dsc-backend-capability-set-v1"
      },
      {
        "field": "capability_set_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal 1.0"
      },
      {
        "field": "spatial_frame_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal normalized_image_plane_v1"
      },
