  "vendor_lifecycle": {
    "lifecycle_id": "dsc-vendor-registry-lifecycle-v1",
    "description": "Lifecycle governing vendor registration records. States and transitions are declared only; no transition is executed in this phase.",
    "states": [
      "pending",
      "active",
      "suspended",
      "deregistered"
    ],
    "initial_state": "pending",
    "active_state": "active",
