  "backend_template_schema": {
    "schema_id": "dsc-backend-template-schema-v1",
    "description": "Shape of a Direct Spatial Conditioning generic backend template. Identity is opaque; no vendor, framework, or device binding is expressed. Templates declare an implementation skeleton, extension points, and a validation template without implementing a backend.",
    "encoding": "application/json",
    "template_id_policy": "opaque_template_id_no_vendor_binding",
    "profile_ref": "dsc-backend-profile-reference-v1",
    "required_fields": [
      {
        "field": "template_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "non-empty opaque identifier; carries no vendor, framework, or device semantics"
      },
      {
        "field": "template_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "major_minor template version string"
      },
      {
        "field": "template_kind",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal generic_backend_template"
      },
      {
        "field": "profile_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must reference the certified profile dsc-backend-profile-reference-v1"
      },
      {
        "field": "capability_set_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal dsc-backend-capability-set-v1"
      },
      {
        "field": "capability_set_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal 1.0"
      },
      {
        "field": "spatial_frame_ref",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal normalized_image_plane_v1"
      },
      {
        "field": "required_channels",
        "type": "array<string>",
        "required": true,
        "nullable": false,
        "constraint": "must equal the six foundation channels in fixed order"
      },
      {
        "field": "deterministic_implementation_skeleton",
        "type": "dsc-backend-deterministic-implementation-skeleton-v1",
        "required": true,
        "nullable": false,
        "constraint": "one ordered step per abstract adapter method with side_effects none"
      },
      {
        "field": "extension_points",
        "type": "dsc-backend-template-extension-points-v1",
        "required": true,
        "nullable": false,
        "constraint": "closed set with one extension point per skeleton step"
      },
      {
        "field": "validation_template",
        "type": "dsc-backend-template-validation-template-v1",
        "required": true,
        "nullable": false,
        "constraint": "must declare mandatory conformance checks over skeleton and extension points"
      }
    ],
    "optional_fields": [],
    "additional_fields": false
  },
  "deterministic_implementation_skeleton": {
    "skeleton_id": "dsc-backend-deterministic-implementation-skeleton-v1",
    "description": "Ordered deterministic skeleton a concrete backend adapter follows. Each step mirrors one abstract PHASE-039 method and is a pure function of its declared inputs. No step is implemented in this phase.",
    "adapter_interface_ref": "dsc-backend-adapter-interface-v1",
    "implementation_spec_ref": "exports/direct_spatial_conditioning/v1/direct-spatial-conditioning-backend-implementation-spec-v1.json",
    "purity": "deterministic_pure_function_per_step",
    "seed_dependence": "none",
    "time_dependence": "none",
    "randomness": "none",
    "step_order": "fixed_declared_order",
    "steps": [
      {
        "step_id": "STEP_DESCRIBE_CAPABILITIES",
        "order": 1,
        "method_id": "describe_capabilities",
        "signature": "describe_capabilities() -> backend_capability_descriptor",
        "description": "Concrete backend publishes its capability declarations for the registered capability set.",
        "reads": [
          "capability_registry.capability_schema.registered_capability_ids"
        ],
        "emits": "backend_capability_descriptor",
        "side_effects": "none",
        "deterministic": true,
        "extension_point_ref": "EXT_DECLARE_CAPABILITIES",
        "implemented_in_this_phase": false
      },
      {
        "step_id": "STEP_CHECK_COMPATIBILITY",
        "order": 2,
        "method_id": "check_compatibility",
        "signature": "check_compatibility(backend_capability_descriptor, dsc_adapted_conditioning_input_v1) -> compatibility_report",
        "description": "Concrete backend resolves its descriptor against the compatibility matrix rows.",
        "reads": [
          "backend_capability_descriptor",
          "capability_registry.compatibility_matrix.rows"
        ],
        "emits": "compatibility_report",
        "side_effects": "none",
        "deterministic": true,
        "extension_point_ref": "EXT_RESOLVE_COMPATIBILITY",
        "implemented_in_this_phase": false
      },
      {
        "step_id": "STEP_BIND_CONDITIONING_INPUT",
        "order": 3,
        "method_id": "bind_conditioning_input",
        "signature": "bind_conditioning_input(dsc_adapted_conditioning_input_v1) -> conditioning_binding_handle",
        "description": "Concrete backend ingests the adapted conditioning input and issues an opaque binding handle.",
        "reads": [
          "dsc_adapted_conditioning_input_v1"
        ],
        "emits": "conditioning_binding_handle",
        "side_effects": "none",
        "deterministic": true,
        "extension_point_ref": "EXT_BIND_ADAPTED_INPUT",
        "implemented_in_this_phase": false
      },
      {
        "step_id": "STEP_RELEASE_CONDITIONING_BINDING",
        "order": 4,
        "method_id": "release_conditioning_binding",
        "signature": "release_conditioning_binding(conditioning_binding_handle) -> void",
        "description": "Concrete backend releases a previously issued conditioning binding handle.",
        "reads": [
          "conditioning_binding_handle"
        ],
        "emits": "void",
        "side_effects": "none",
        "deterministic": true,
        "extension_point_ref": "EXT_RELEASE_BINDING",
        "implemented_in_this_phase": false
      }
    ],
    "same_inputs_same_outcome": true,
    "requires_gpu": false,
    "performs_inference": false,
    "implements_steps_in_this_phase": false
  },
  "extension_points": {
    "extension_points_id": "dsc-backend-template-extension-points-v1",
    "description": "Closed set of extension points a concrete backend fills. Every point is bound to exactly one skeleton step and inherits the deterministic constraints of the template.",
    "closed_set": true,
    "points": [
      {
        "extension_point_id": "EXT_DECLARE_CAPABILITIES",
        "target_method_id": "describe_capabilities",
        "category": "capability_declaration",
        "description": "Concrete backend publishes its capability declarations for the registered capability set.",
        "contract": "must emit one declaration per registered capability id in registry order and declare no unregistered id",
        "must_remain_deterministic": true,
        "may_require_gpu": false,
        "may_perform_inference": false,
        "may_modify_certified_artifacts": false,
        "filled_in_this_phase": false
      },
      {
        "extension_point_id": "EXT_RESOLVE_COMPATIBILITY",
