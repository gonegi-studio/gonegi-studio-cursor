      },
      {
        "field": "runtime_profile_descriptor_composition",
        "type": "dsc-vendor-runtime-profile-descriptor-composition-v1",
        "required": true,
        "nullable": false,
        "constraint": "closed, fixed-order set of runtime profile reference artifact, schema, and implementation registry sections; vendor-specific sections forbidden and profile reference contents never re-listed"
      },
