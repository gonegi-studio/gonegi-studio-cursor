        "nullable": false,
        "constraint": "must reference the vendor runtime profile reference dsc-vendor-runtime-profile-reference-v1"
      },
      {
        "field": "capability_set_id",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal dsc-backend-capability-set-v1"
      },
      {
        "field": "capability_set_version",
        "type": "string",
        "required": true,
        "nullable": false,
        "constraint": "must equal 1.0"
      },
      {
        "field": "spatial_frame_ref",
