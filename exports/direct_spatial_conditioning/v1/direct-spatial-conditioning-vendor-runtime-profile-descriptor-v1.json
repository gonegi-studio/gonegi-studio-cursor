        "type": "dsc-vendor-runtime-profile-descriptor-deterministic-identity-v1",
        "required": true,
        "nullable": false,
        "constraint": "opaque deterministic identity with no seed, time, randomness, vendor name, framework, or device dependence"
      },
      {
        "field": "vendor_runtime_profile_reference_binding",
