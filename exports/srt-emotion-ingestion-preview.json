        {
          "segment_index": 1,
          "cue_id": "1",
          "start_ms": 0,
          "end_ms": 14000,
          "text": "고요한 마음, 너를 기다리네"
        },
        {
          "segment_index": 2,
          "cue_id": "2",
          "start_ms": 14000,
          "end_ms": 28000,
          "text": "멀어진 기억 속에 남은 너"
        },
        {
          "segment_index": 3,
          "cue_id": "3",
          "start_ms": 28000,
          "end_ms": 41000,
          "text": "말없이 스친 눈빛 하나"
        },
        {
          "segment_index": 4,
          "cue_id": "4",
          "start_ms": 41000,
          "end_ms": 54000,
          "text": "문 앞에서 멈춘 그대 이름"
        },
        {
          "segment_index": 5,
          "cue_id": "5",
          "start_ms": 54000,
          "end_ms": 67000,
          "text": "비 내리는 창, 그리운 숨결"
        },
        {
          "segment_index": 6,
          "cue_id": "6",
          "start_ms": 67000,
          "end_ms": 80000,
          "text": "노을 너머 희망을 걸어"
        },
        {
          "segment_index": 7,
          "cue_id": "7",
          "start_ms": 80000,
          "end_ms": 93000,
          "text": "아침빛에 새 길을 열고"
        },
        {
          "segment_index": 8,
          "cue_id": "8",
          "start_ms": 93000,
          "end_ms": 106000,
          "text": "마주 선 두 마음의 긴장"
        },
        {
          "segment_index": 9,
          "cue_id": "9",
          "start_ms": 106000,
          "end_ms": 119000,
          "text": "해야 할 일 앞에 선 채"
        },
        {
          "segment_index": 10,
          "cue_id": "10",
          "start_ms": 119000,
          "end_ms": 132000,
          "text": "따뜻한 차 한 모금, 작은 위로"
        },
        {
          "segment_index": 11,
          "cue_id": "11",
          "start_ms": 132000,
          "end_ms": 145000,
          "text": "다시 손 내밀며 믿음을"
        },
        {
          "segment_index": 12,
          "cue_id": "12",
          "start_ms": 145000,
          "end_ms": 158000,
          "text": "드디어 닿은 두 손의 온기"
        },
        {
          "segment_index": 13,
          "cue_id": "13",
          "start_ms": 158000,
          "end_ms": 171000,
          "text": "높은 곳에서 작별 인사"
        },
        {
          "segment_index": 14,
          "cue_id": "14",
          "start_ms": 171000,
          "end_ms": 184000,
          "text": "걸으며 배우는 작은 용기"
        },
        {
          "segment_index": 15,
          "cue_id": "15",
          "start_ms": 184000,
          "end_ms": 197000,
          "text": "별 아래 꽃에 물을 주며"
        },
        {
          "segment_index": 16,
          "cue_id": "16",
          "start_ms": 197000,
          "end_ms": 210000,
          "text": "새 아침, 다시 지켜 줄게"
